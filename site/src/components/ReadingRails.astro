---
// Shared client script for the reading experience: scroll-spy for the
// on-this-page rail and the reading-progress meter. Plain vanilla, tiny,
// no framework; both features degrade to nothing without JS.
---

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'))
  const targets = links
    .map((a) => document.getElementById(a.getAttribute('href')!.slice(1)))
    .filter((el): el is HTMLElement => el !== null)
  if (targets.length) {
    const activate = (id: string) => {
      for (const a of links) a.classList.toggle('active', a.getAttribute('href') === `#${id}`)
    }
    const obs = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) activate(e.target.id)
      },
      { rootMargin: '-15% 0px -75% 0px' },
    )
    for (const t of targets) obs.observe(t)
  }

  const num = document.querySelector<HTMLElement>('.progress-num')
  const bar = document.querySelector<HTMLElement>('.progress-bar i')
  if (num && bar) {
    let ticking = false
    const update = () => {
      const doc = document.documentElement
      const max = doc.scrollHeight - window.innerHeight
      const pct = max > 0 ? Math.min(100, Math.round((window.scrollY / max) * 100)) : 100
      num.textContent = `${pct}%`
      bar.style.width = `${pct}%`
      ticking = false
    }
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true
        requestAnimationFrame(update)
      }
    }, { passive: true })
    update()
  }
</script>
