---
// Inline rich text for chapter prose: `code` gets the mono measurement
// treatment, **bold** gets weight, $math$ renders through KaTeX at build
// time, and glossary terms get a dotted underline with a hover card
// (definition plus the chapter that teaches the term). Input is our own
// authored strings, escaped before markup so no raw HTML ever passes
// through except KaTeX's own output and the term cards built here.
import katex from 'katex'
import { GLOSSARY } from '../lib/glossary'

interface Props {
  text: string
  /** Set false on surfaces that should stay quiet (labels, captions, links). */
  terms?: boolean
  /** The current chapter href; terms taught on this very page stay plain. */
  self?: string
}
const { text, terms = true, self } = Astro.props

const escaped = text
  .replaceAll('&', '&amp;')
  .replaceAll('<', '&lt;')
  .replaceAll('>', '&gt;')

// protect math and code spans, then wrap the first occurrence of each
// glossary term in the remaining plain prose
const stash: string[] = []
let working = escaped.replace(/\$[^$]+\$|`[^`]+`/g, (m) => {
  stash.push(m)
  return `${stash.length - 1}`
})

if (terms) {
  const patterns = GLOSSARY.filter((g) => g.href !== self)
    .flatMap((g) => [g.t, ...(g.alt ?? [])].map((p) => ({ p, g })))
    .sort((a, b) => b.p.length - a.p.length)
  const canon = new Map(patterns.map(({ p, g }) => [p, g]))
  const re = new RegExp(
    `(?<![\\w.])(${patterns.map(({ p }) => p.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})(?![\\w.])`,
    'g',
  )
  const seen = new Set<string>()
  working = working.replace(re, (m) => {
    const g = canon.get(m)!
    if (seen.has(g.t)) return m
    seen.add(g.t)
    const chapter = g.href.split('/').pop()
    return (
      `<span class="term" tabindex="0">${m}<span class="pop" role="note">` +
      `<span class="pop-def">${g.d}</span>` +
      `<a class="pop-link" href="${g.href}">taught in /l/${chapter} →</a>` +
      `</span></span>`
    )
  })
}

working = working.replace(/(\d+)/g, (_m, i: string) => stash[Number(i)]!)

const html = working
  .replace(/\$([^$]+)\$/g, (_m, tex: string) =>
    katex.renderToString(tex.replaceAll('&amp;', '&').replaceAll('&lt;', '<').replaceAll('&gt;', '>'), {
      throwOnError: false,
    }),
  )
  .replace(/`([^`]+)`/g, '<code class="ri">$1</code>')
  .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
---

<span set:html={html} />

<style is:global>
  code.ri {
    font-family: var(--mono);
    font-size: 0.85em;
    background: var(--plate-2);
    border: 1px solid var(--edge-soft);
    border-radius: 3px;
    padding: 0.05em 0.3em;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .panel code.ri { background: #1a1d21; border-color: var(--panel-rule); }

  .term {
    position: relative;
    border-bottom: 1px dotted var(--copper-deep);
    cursor: help;
  }
  .term:focus-visible { outline: 2px solid var(--copper-deep); outline-offset: 1px; }
  .term .pop {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 70;
    width: max-content;
    min-width: 14rem;
    max-width: 21rem;
    display: none;
    flex-direction: column;
    gap: 0.45rem;
    background: #101215;
    color: #d6d9dc;
    border: 1px solid #2c3138;
    border-left: 3px solid var(--copper-deep);
    padding: 0.65rem 0.8rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.6;
    text-align: left;
    white-space: normal;
    box-shadow: 0 6px 24px rgba(10, 11, 13, 0.35);
  }
  .term:hover .pop, .term:focus .pop, .term:focus-within .pop { display: flex; }
  .term .pop-def { color: #c9cdd1; }
  .term .pop-link { color: var(--copper); text-decoration: none; }
  .term .pop-link:hover { text-decoration: underline; }
  @media (max-width: 700px) {
    .term .pop { left: 0; transform: none; max-width: 16rem; }
  }
</style>
