---
// Renders guide sections (the block grammar: p, code, callout, gallery, cf,
// mistake, exercise, diagram) for a layer hub or for a lesson that slices a
// guide. Self-contained: loads the guide JSON and every corpus it can pull
// from. One telling per fact lives here; hubs and lessons choose sections.
import { Code } from 'astro:components'
import MlirCode from './MlirCode.astro'
import FullDump from './FullDump.astro'
import BlockDiagram from './BlockDiagram.astro'
import Rich from './Rich.astro'
import SectionHead from './SectionHead.astro'
import { DIAGRAMS } from '../data/diagrams'
import gallery from '../data/transform-gallery.json'
import cfCorpus from '../data/cf-corpus.json'
import mistakes from '../data/mistakes.json'

export interface GuideBlock {
  kind: 'p' | 'code' | 'callout' | 'gallery' | 'cf' | 'mistake' | 'exercise' | 'diagram'
  text?: string
  caption?: string
  lang?: string
  label?: string
  href?: string
  id?: string
  which?: 'source' | 'jaxpr' | 'stablehlo'
  lines?: [number, number]
}
export interface GuideSection {
  h: string
  blocks: GuideBlock[]
}

interface Props {
  guideId: string
  /** Original section indices to render; omit for the whole guide. */
  sections?: number[]
  /** The page rendering this, for glossary self-suppression. */
  self: string
  /** 'guide' numbers by original index; 'lesson' numbers by position. */
  numbering?: 'guide' | 'lesson'
}
const { guideId, sections, self, numbering = 'guide' } = Astro.props

const guideModules = import.meta.glob('../data/guides/*.json', { eager: true }) as Record<
  string,
  { default: { sections: GuideSection[] } }
>
const guide = guideModules[`../data/guides/${guideId}.json`]?.default
if (!guide) throw new Error(`unknown guide: ${guideId}`)
const picked = (sections ?? guide.sections.map((_, i) => i)).map((i) => {
  const sec = guide.sections[i]
  if (!sec) throw new Error(`guide ${guideId} has no section ${i}`)
  return { sec, i }
})

const galleryVariant = (id: string) => (gallery.variants as { id: string; title: string; note: string; jaxpr: string[] }[]).find((v) => v.id === id)
const cfProgram = (id: string) => (cfCorpus.programs as { id: string; title: string; note: string; source: string[]; jaxpr: string[]; stablehlo: string[] }[]).find((p) => p.id === id)
const mistakeById = (id: string) => (mistakes as { id: string; title: string; error: string }[]).find((m) => m.id === id)
const pad = (n: number) => String(n).padStart(2, '0')
const slug = (h: string) => h.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
---

<div class="guide-sections">
  {
    picked.map(({ sec, i }, pos) => (
      <section class="block prose">
        <SectionHead
          id={slug(sec.h)}
          eyebrow={numbering === 'guide' ? `guide § ${pad(i + 1)}` : `§ ${pad(pos + 1)}`}
          title={sec.h.charAt(0).toUpperCase() + sec.h.slice(1)}
        />
        {sec.blocks.map((b) => {
          if (b.kind === 'p') return (
            <p class="theory">
              <Rich text={b.text!} self={self} />
            </p>
          )
          if (b.kind === 'code') return (
            <figure class="panel codefig">
              <figcaption class="provenance top">{b.caption}</figcaption>
              <div class="codebody">
                {b.lang === 'mlir' ? <MlirCode code={b.text!} /> : <Code code={b.text!} lang="python" theme="vesper" />}
              </div>
            </figure>
          )
          if (b.kind === 'gallery') {
            const v = galleryVariant(b.id!)
            if (!v) return null
            return (
              <figure class="panel codefig">
                <figcaption class="provenance top">{v.title} · {v.note} · generated by gen_transform_gallery.py</figcaption>
                <div class="codebody">
                  <Code code={(b.lines ? v.jaxpr.slice(b.lines[0], b.lines[1] + 1) : v.jaxpr).join('\n')} lang="haskell" theme="vesper" />
                </div>
                {b.lines && <FullDump text={v.jaxpr.join('\n')} lang="haskell" label="the full jaxpr" />}
              </figure>
            )
          }
          if (b.kind === 'cf') {
            const p = cfProgram(b.id!)
            if (!p) return null
            const text = (p[b.which ?? 'stablehlo'] as string[])
            return (
              <figure class="panel codefig">
                <figcaption class="provenance top">{p.title} · generated by gen_cf_corpus.py</figcaption>
                <div class="codebody">
                  {b.which === 'stablehlo' || b.which === undefined ? (
                    <MlirCode code={(b.lines ? text.slice(b.lines[0], b.lines[1] + 1) : text).join('\n')} />
                  ) : (
                    <Code
                      code={(b.lines ? text.slice(b.lines[0], b.lines[1] + 1) : text).join('\n')}
                      lang={b.which === 'jaxpr' ? 'haskell' : 'python'}
                      theme="vesper"
                    />
                  )}
                </div>
                {b.lines && (
                  <FullDump
                    text={text.join('\n')}
                    lang={b.which === 'stablehlo' || b.which === undefined ? 'mlir' : b.which === 'jaxpr' ? 'haskell' : 'python'}
                    label={`the full ${b.which ?? 'stablehlo'}`}
                  />
                )}
              </figure>
            )
          }
          if (b.kind === 'mistake') {
            const m = mistakeById(b.id!)
            if (!m) return null
            return (
              <figure class="panel codefig">
                <figcaption class="provenance top">museum exhibit: {m.title} · the error, verbatim</figcaption>
                <div class="codebody errbody">
                  <pre>{b.lines ? m.error.split('\n').slice(b.lines[0], b.lines[1] + 1).join('\n') : m.error}</pre>
                </div>
              </figure>
            )
          }
          if (b.kind === 'diagram') {
            const d = DIAGRAMS[b.id!]
            if (!d) return null
            return (
              <figure class="panel codefig">
                <figcaption class="provenance top">{d.caption}</figcaption>
                <BlockDiagram spec={d} />
              </figure>
            )
          }
          if (b.kind === 'exercise') return (
            <div class="plate exercise">
              <span class="mono-label ex-tag">exercise</span>
              <span class="ex-text"><Rich text={b.text!} self={self} /></span>
            </div>
          )
          if (b.kind === 'callout') return (
            <aside class="plate crossref">
              <span class="mono-label">{b.label}</span>
              {b.href ? (
                <a href={b.href} target={b.href.startsWith('http') ? '_blank' : undefined} rel={b.href.startsWith('http') ? 'noopener' : undefined}>
                  <Rich text={b.text!} terms={false} />
                  {b.href.startsWith('http') && ' ↗'}
                </a>
              ) : (
                <span class="crossref-text"><Rich text={b.text!} terms={false} /></span>
              )}
            </aside>
          )
          return null
        })}
      </section>
    ))
  }
</div>

<style>
  .guide-sections { counter-reset: exercise; }
  .block { margin-top: 2.5rem; }
  .theory { margin-bottom: 1em; }

  .codefig { margin: 1.25rem 0 0; }
  .codefig .top { border-top: none; border-bottom: 1px solid var(--panel-rule); }
  .codebody :global(pre) { margin: 0; padding: 0.875rem; overflow-x: auto; font-size: 0.8125rem; line-height: 1.65; background: transparent !important; }
  .errbody pre { color: #d4a09a; font-family: var(--mono); white-space: pre-wrap; }

  .plate.exercise { display: flex; flex-direction: column; gap: 0.375rem; border-left: 4px solid var(--accent); padding: 0.875rem 1.125rem; margin: 1rem 0; counter-increment: exercise; }
  .exercise .ex-tag { color: var(--accent-ink); text-shadow: var(--bloom); }
  .exercise .ex-tag::after { content: " · " counter(exercise, decimal-leading-zero); }
  .exercise .ex-text { font-size: 0.9375rem; line-height: 1.65; color: var(--ink); max-width: 68ch; }

  .crossref { display: flex; flex-direction: column; gap: 0.25rem; padding: 0.75rem 1rem; margin: 1rem 0; }
  .crossref a, .crossref .crossref-text { font-family: var(--mono); font-size: 0.8125rem; color: var(--ink); text-decoration: none; }
  .crossref a:hover { color: var(--accent-ink); text-decoration: underline; }
</style>
