---
// The unit's lesson syllabus: ordered depth lessons nested under this
// chapter. Rendered on the hub between orientation and practice.
import { lessonsOf, lessonHref, lessonKey } from '../data/lessons'

interface Props {
  unit: string
}
const { unit } = Astro.props
const lessons = lessonsOf(unit)
const pad = (n: number) => String(n).padStart(2, '0')
---

{
  lessons.length > 0 && (
    <ol class="lessonlist">
      {lessons.map((l) => (
        <li>
          <a class="plate" href={lessonHref(unit, l.id)} data-chapter-key={lessonKey(unit, l.id)}>
            <span class="num">{pad(l.num)}</span>
            <span class="body">
              <span class="t">{l.title}</span>
              <span class="l">{l.lede}</span>
            </span>
            <span class="frac meas" data-work-frac={lessonKey(unit, l.id)}>
              ·
            </span>
          </a>
        </li>
      ))}
    </ol>
  )
}

<style>
  .lessonlist { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .lessonlist a { display: flex; gap: 1rem; align-items: baseline; padding: 0.875rem 1rem; text-decoration: none; }
  .lessonlist .num { font-family: var(--mono); font-size: 0.8125rem; color: var(--accent-deep); }
  .lessonlist .body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.2rem; }
  .lessonlist .t { color: var(--ink); font-weight: 500; }
  .lessonlist .l { color: var(--ink-mute); font-size: 0.875rem; }
  .lessonlist .frac { font-family: var(--mono); font-size: 0.6875rem; color: var(--ink-mute); }
  :global(.lessonlist a.p-done) .frac { color: var(--pass); }
</style>
