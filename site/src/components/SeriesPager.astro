---
// The one next control for series pages; order comes from lib/series.ts
// alone, same contract as PathPager and lib/path.ts on the kernel path.
import { seriesPageAt } from '../lib/series'

interface Props {
  seriesId: string
  pageId: string
}
const { seriesId, pageId } = Astro.props
const { series, prev, next } = seriesPageAt(seriesId, pageId)
const pad = (n: number) => String(n).padStart(2, '0')
const key = `sr:${seriesId}:${pageId}`
---

<nav class="pathpager" aria-label={`The ${series.title} series`}>
  <div class="pp-left">
    {
      prev ? (
        <a class="pp-prev" href={`/series/${series.id}/${prev.id}`}>← pg {pad(prev.num)} · {prev.title}</a>
      ) : (
        <a class="pp-prev" href={`/series/${series.id}`}>← {series.title.toLowerCase()}, the series</a>
      )
    }
    <span class="pp-work">this page's work · <span data-work-frac={key}>·</span></span>
  </div>
  {
    next ? (
      <a class="pp-next" href={`/series/${series.id}/${next.id}`}>
        <span class="pp-k">next in the series</span>
        <span class="pp-t">pg {pad(next.num)} · {next.title} →</span>
      </a>
    ) : (
      <a class="pp-next" href={series.deepens[0]?.href ?? '/'}>
        <span class="pp-k">the series ends here</span>
        <span class="pp-t">back to {series.deepens[0]?.label ?? 'the path'} →</span>
      </a>
    )
  }
</nav>

<style>
  .pathpager { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 3.5rem; padding-top: 1.25rem; border-top: 1px solid var(--rule); }
  .pp-left { display: flex; flex-direction: column; gap: 0.375rem; }
  .pp-work { font-family: var(--mono); font-size: 0.6875rem; color: var(--ink-mute); }
  .pp-prev { font-family: var(--mono); font-size: 0.75rem; color: var(--ink-mute); text-decoration: none; }
  .pp-prev:hover { color: var(--copper-deep); }
  .pp-next { display: inline-flex; flex-direction: column; gap: 0.25rem; align-items: flex-end; text-align: right; text-decoration: none; border: 1px solid var(--copper-deep); background: var(--paper-high); padding: 0.625rem 0.875rem; border-radius: 2px; }
  .pp-next:hover { background: var(--paper); }
  .pp-k { font-family: var(--mono); font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-mute); }
  .pp-t { font-family: var(--mono); font-size: 0.8125rem; color: var(--copper-deep); }
</style>
