---
// A bench card: one runnable lab. Links straight into Colab from GitHub once
// the notebook exists; states the truth until then.
import type { Lab } from '../data/track'

interface Props {
  lab: Lab
}
const { lab } = Astro.props
---

<article class="panel lab">
  <div class="body">
    <div class="top">
      <span class="designator">{lab.designator}</span>
      <span class="meta">{lab.time} · {lab.hardware}</span>
    </div>
    <h3>{lab.title}</h3>
  </div>
  <div class="provenance action-row">
    {
      lab.colab ? (
        <a href={lab.colab} rel="noopener">open in Colab → runs from this repo, save a copy to keep it</a>
      ) : (
        <span>notebook lands with this stage</span>
      )
    }
  </div>
</article>

<style>
  .lab { display: flex; flex-direction: column; }
  .body { padding: 0.875rem; flex: 1; }
  .top { display: flex; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
  .designator { color: var(--copper); }
  .meta { font-size: 0.6875rem; color: var(--panel-mute); letter-spacing: 0.03em; }
  h3 { font-family: var(--mono); font-size: 0.9375rem; font-weight: 500; letter-spacing: 0.01em; }
  .action-row a { color: var(--copper); text-decoration: none; }
  .action-row a:hover { text-decoration: underline; }
</style>
