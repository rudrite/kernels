---
// A bench card: one runnable lab. Links straight into Colab from GitHub once
// the notebook exists; states the truth until then.
import type { Lab } from '../data/track'

interface Props {
  lab: Lab
}
const { lab } = Astro.props
---

<article class="panel lab">
  {lab.colab && <a class="card-link" href={lab.colab} target="_blank" rel="noopener" aria-label={`Open ${lab.designator} in Colab (new tab)`}></a>}
  <div class="body">
    <div class="top">
      <span class="designator">{lab.designator}</span>
      <span class="meta">{lab.time} · {lab.hardware}</span>
      <button type="button" class="lab-toggle" data-lab-toggle={lab.designator}>mark as run</button>
    </div>
    <h3>{lab.title}</h3>
  </div>
  <div class="provenance action-row">
    {
      lab.colab ? (
        <a href={lab.colab} target="_blank" rel="noopener">open in Colab ↗ · runs from this repo, save a copy to keep it</a>
      ) : lab.notebook ? (
        <span>in repo: {lab.notebook} · Colab link activates when the repo goes public</span>
      ) : (
        <span>notebook lands with this stage</span>
      )
    }
  </div>
</article>

<style>
  .lab { display: flex; flex-direction: column; position: relative; }
  .card-link { position: absolute; inset: 0; z-index: 0; border-radius: 2px; }
  .lab:has(.card-link):hover { border-color: var(--accent); }
  .lab .lab-toggle, .lab .action-row a { position: relative; z-index: 1; }
  .body { padding: 0.875rem; flex: 1; }
  .top { display: flex; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
  .designator { color: var(--accent-ink); }
  .meta { font-size: 0.6875rem; color: var(--panel-mute); letter-spacing: 0.03em; }
  h3 { font-family: var(--mono); font-size: 0.9375rem; font-weight: 500; letter-spacing: 0.01em; }
  .action-row a { color: var(--accent-ink); text-decoration: none; }
  .action-row a:hover { text-decoration: underline; }
</style>
