---
// The lesson template: one depth lesson nested under its unit chapter. The
// route files supply course context; order within the unit comes from the
// lessons registry alone.
import { Code } from 'astro:components'
import Base from '../layouts/Base.astro'
import Rich from './Rich.astro'
import SectionHead from './SectionHead.astro'
import ReadingRails from './ReadingRails.astro'
import MasteryWork from './MasteryWork.astro'
import MiniMap from './MiniMap.astro'
import BlockDiagram from './BlockDiagram.astro'
import MlirCode from './MlirCode.astro'
import FullDump from './FullDump.astro'
import Exhibit from './Exhibit.astro'
import SystolicArray from '../exhibits/SystolicArray'
import TorusHops from '../exhibits/TorusHops'
import FabricCompare from '../exhibits/FabricCompare'
import GuideSections from './GuideSections.astro'
import { lessonAt, lessonHref, lessonKey } from '../data/lessons'
import { LESSON_DIAGRAMS } from '../data/lessons/diagrams'

// The instrument roster for lessons; sections reference these by id.
const INSTRUMENTS: Record<string, { d: string; t: string; p: string }> = {
  systolic: {
    d: 'EX·19',
    t: 'the systolic array, cycle by cycle',
    p: 'a 6x6 stand-in for the real grid · fill, steady state, drain · MAC readout scaled to 128x128 (v5e) or 256x256 (v6e) per jax-ml.github.io/scaling-book/tpus/',
  },
  torus: {
    d: 'EX·20',
    t: 'the torus, hop by hop',
    p: 'an 8x8 axis pair standing for 16x16 · hop counts exact for the drawn grid · link constants from jax-ml.github.io/scaling-book/tpus/',
  },
  fabric: {
    d: 'EX·21',
    t: 'two fabrics, one question',
    p: 'hop distance on a wrapped 4x4 torus against one switched 8-GPU node · egress constants from jax-ml.github.io/scaling-book (tpus, gpus)',
  },
}

interface Props {
  /** Chapter key: 'l:tpu' | 's:machine' | 'xla:pjrt' ... */
  unit: string
  unitTitle: string
  unitHref: string
  course: string
  courseHref: string
  lessonId: string
}
const { unit, unitTitle, unitHref, course, courseHref, lessonId } = Astro.props
const { lessons, current: lesson, prev, next } = lessonAt(unit, lessonId)
const key = lessonKey(unit, lesson.id)
const self = lessonHref(unit, lesson.id)
const pad = (n: number) => String(n).padStart(2, '0')
const slug = (h: string) => h.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')

// When the lesson slices a guide, its body lives there; the toc lists the
// sliced sections' headings.
const guideModules = import.meta.glob('../data/guides/*.json', { eager: true }) as Record<
  string,
  { default: { sections: { h: string }[] } }
>
const guideHeads = lesson.guide
  ? lesson.guide.sections.map((i) => guideModules[`../data/guides/${lesson.guide!.id}.json`]!.default.sections[i]!.h)
  : []
---

<Base title={`${lesson.title} · ${unitTitle} · Rudrite Kernels`} description={lesson.lede}>
  <section class="chapter-head">
    <div class="wrap">
      <p class="mono-label kicker">
        {course} · <a class="kicker-unit" href={unitHref}>{unitTitle}</a> · lesson {pad(lesson.num)} of {lessons.length}
      </p>
      <h1>{lesson.title}</h1>
      <p class="lede"><Rich text={lesson.lede} self={self} /></p>
      <p class="goal"><span class="mono-label">the goal</span> <Rich text={lesson.goal} self={self} /></p>
    </div>
  </section>

  <div class="wrap layout">
    <aside class="side">
      <MiniMap unit={unit} />
      <nav class="pathmap" aria-label="This unit's lessons">
        <span class="mono-label toc-head">this unit's lessons</span>
        <ol>
          {
            lessons.map((l) => (
              <li class={l.id === lesson.id ? 'here' : ''}>
                <a href={lessonHref(unit, l.id)} data-chapter-key={lessonKey(unit, l.id)}>
                  <span class="pm-num">{pad(l.num)}</span>
                  <span class="pm-title">{l.title}</span>
                  <span class="pm-frac meas" data-work-frac={lessonKey(unit, l.id)} />
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <nav class="toc" aria-label="On this page">
        <span class="mono-label toc-head">on this page</span>
        <ol>
          {lesson.sections.map((sec) => <li><a href={`#${slug(sec.h)}`}>{sec.h}</a></li>)}
          {guideHeads.map((h) => <li><a href={`#${slug(h)}`}>{h}</a></li>)}
          {lesson.check && <li><a href="#check">check yourself</a></li>}
        </ol>
      </nav>
    </aside>

    <article class="main">
      <MasteryWork chapterKey={key} />

      {
        lesson.sections.map((sec, si) => (
          <section class="block prose">
            <SectionHead id={slug(sec.h)} eyebrow={`§ ${pad(si + 1)}`} title={sec.h.charAt(0).toUpperCase() + sec.h.slice(1)} />
            {sec.ps.map((p) =>
              p.startsWith('>> ') ? (
                <blockquote class="pull">{p.slice(3)}</blockquote>
              ) : (
                <p class="theory">
                  <Rich text={p} self={self} />
                </p>
              ),
            )}
            {sec.code && (
              <figure class="panel codefig">
                <figcaption class="provenance top">{sec.code.caption}</figcaption>
                <div class="codebody">
                  {sec.code.lang === 'mlir' ? (
                    <MlirCode code={sec.code.text} />
                  ) : (
                    <Code code={sec.code.text} lang={sec.code.lang === 'text' ? 'txt' : (sec.code.lang ?? 'python')} theme="vesper" />
                  )}
                </div>
                {sec.code.full && (
                  <FullDump
                    text={sec.code.full.text}
                    lang={sec.code.lang}
                    label={sec.code.full.label}
                    href={sec.code.full.href}
                    hrefLabel={sec.code.full.hrefLabel}
                  />
                )}
              </figure>
            )}
            {sec.table && (
              <figure class="tablefig">
                <div class="tablescroll">
                  <table>
                    <thead>
                      <tr>{sec.table.cols.map((c) => <th>{c}</th>)}</tr>
                    </thead>
                    <tbody>
                      {sec.table.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}
                    </tbody>
                  </table>
                </div>
                <figcaption class="provenance">{sec.table.caption}</figcaption>
              </figure>
            )}
            {sec.diagram && LESSON_DIAGRAMS[sec.diagram] && (
              <figure class="panel codefig">
                <figcaption class="provenance top">{LESSON_DIAGRAMS[sec.diagram]!.caption}</figcaption>
                <BlockDiagram spec={LESSON_DIAGRAMS[sec.diagram]!} />
              </figure>
            )}
            {sec.exhibit && INSTRUMENTS[sec.exhibit] && (
              <div class="exwrap">
                <Exhibit designator={INSTRUMENTS[sec.exhibit]!.d} title={INSTRUMENTS[sec.exhibit]!.t} provenance={INSTRUMENTS[sec.exhibit]!.p}>
                  {sec.exhibit === 'systolic' && <SystolicArray client:visible />}
                  {sec.exhibit === 'torus' && <TorusHops client:visible />}
                  {sec.exhibit === 'fabric' && <FabricCompare client:visible />}
                </Exhibit>
              </div>
            )}
          </section>
        ))
      }

      {
        lesson.guide && (
          <GuideSections guideId={lesson.guide.id} sections={lesson.guide.sections} self={self} numbering="lesson" />
        )
      }

      {
        lesson.check && lesson.check.length > 0 && (
          <section class="block">
            <SectionHead id="check" eyebrow="before you move on" title="Check yourself" />
            <div class="checks">
              {lesson.check.map((c, ci) => (
                <details class="check">
                  <summary>
                    <span class="q-num meas">{pad(ci + 1)}</span>
                    <span class="q">{c.q}</span>
                  </summary>
                  <p class="a">{c.a}</p>
                </details>
              ))}
            </div>
          </section>
        )
      }

      <section class="block">
        <SectionHead id="readings" eyebrow="assigned" title="Readings" />
        <ul class="readings">
          {
            lesson.readings.map((r) => (
              <li>
                <a href={r.url} target="_blank" rel="noopener">{r.label} ↗</a>
                <span class="r-note">{r.note}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <nav class="pathpager" aria-label="This unit's lessons">
        <div class="pp-left">
          {
            prev ? (
              <a class="pp-prev" href={lessonHref(unit, prev.id)}>← lesson {pad(prev.num)} · {prev.title}</a>
            ) : (
              <a class="pp-prev" href={unitHref}>← the chapter · {unitTitle}</a>
            )
          }
          <span class="pp-work">this lesson's work · <span data-work-frac={key}>·</span></span>
        </div>
        {
          next ? (
            <a class="pp-next" href={lessonHref(unit, next.id)}>
              <span class="pp-k">next lesson</span>
              <span class="pp-t">lesson {pad(next.num)} · {next.title} →</span>
            </a>
          ) : (
            <a class="pp-next" href={unitHref}>
              <span class="pp-k">the lessons end here</span>
              <span class="pp-t">back to the chapter · {unitTitle} →</span>
            </a>
          )
        }
      </nav>
    </article>

    <aside class="right">
      <div class="rail">
        <div>
          <span class="rail-head">reading progress</span>
          <span class="progress-num meas">0%</span>
          <div class="progress-bar"><i></i></div>
        </div>
        <div>
          <span class="rail-head">this lesson</span>
          <div class="card">
            <div class="row"><span class="k">lesson</span><span>{pad(lesson.num)} of {lessons.length}</span></div>
            <div class="row"><span class="k">unit</span><span>{unitTitle}</span></div>
            <div class="row"><span class="k">readings</span><span>{lesson.readings.length} assigned</span></div>
          </div>
        </div>
        <div>
          <span class="rail-head">part of</span>
          <ul>
            <li><a href={unitHref}>{unitTitle} · the chapter</a></li>
            <li><a href={courseHref}>{course}</a></li>
          </ul>
        </div>
      </div>
    </aside>
  </div>
  <ReadingRails />
</Base>

<style>
  .layout { display: grid; grid-template-columns: 13.5rem minmax(0, 1fr) 13rem; gap: 3rem; padding-block: 2.5rem; }
  .side, .right { position: sticky; top: 2rem; align-self: start; }
  @media (max-width: 1240px) { .layout { grid-template-columns: 13.5rem minmax(0, 1fr); } .right { display: none; } }
  @media (max-width: 960px) { .layout { grid-template-columns: minmax(0, 1fr); } .side { display: none; } }

  .chapter-head { padding-block: 2rem 2.25rem; background: var(--paper-high); border-bottom: 1px solid var(--rule); }
  .chapter-head .kicker { color: var(--accent-deep); margin-bottom: 0.875rem; }
  .kicker-unit { color: inherit; }
  .chapter-head h1 { font-size: clamp(1.875rem, 4.5vw, 2.75rem); font-weight: 600; letter-spacing: -0.01em; }
  .chapter-head .lede { margin-top: 0.75rem; font-size: 1.1875rem; color: var(--ink-mute); max-width: 62ch; }
  .chapter-head .goal { margin-top: 0.875rem; font-size: 0.9375rem; color: var(--ink); max-width: 70ch; border-left: 3px solid var(--copper-deep); padding-left: 0.875rem; }
  .chapter-head .goal .mono-label { color: var(--copper-deep); margin-right: 0.5rem; }

  .block { margin-top: 2.5rem; }
  .theory { margin-bottom: 1em; }

  .pull {
    margin: 1.25rem 0; padding: 0.25rem 0 0.25rem 1.125rem;
    border-left: 3px solid var(--copper-deep);
    font-family: var(--serif); font-style: italic; font-size: 1.1875rem; line-height: 1.5;
    color: var(--ink);
  }

  .pathmap ol { list-style: none; margin: 0.5rem 0 0; padding: 0; }
  .pathmap a { display: flex; align-items: baseline; gap: 0.5rem; padding: 0.22rem 0; text-decoration: none; color: var(--ink-mute); font-size: 0.8125rem; }
  .pathmap a:hover { color: var(--accent-deep); }
  .pathmap li.here a { color: var(--accent-deep); font-weight: 500; }
  .pm-num { font-family: var(--mono); font-size: 0.6875rem; color: var(--accent-deep); }
  .pm-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pm-frac { font-family: var(--mono); font-size: 0.625rem; color: var(--ink-mute); }
  :global(.pathmap [data-chapter-key].p-done) .pm-frac { color: var(--pass); }
  .toc { margin-top: 1.5rem; }

  .codefig { margin: 1.25rem 0 0; }
  .codefig .top { border-top: none; border-bottom: 1px solid var(--panel-rule); }
  .codebody :global(pre) { margin: 0; padding: 0.875rem; overflow-x: auto; font-size: 0.8125rem; line-height: 1.65; background: transparent !important; }

  .exwrap { margin-top: 1.25rem; }

  .tablefig { margin: 1.25rem 0 0; }
  .tablescroll { overflow-x: auto; border: 1px solid var(--rule); background: var(--paper-high); }
  .tablefig table { border-collapse: collapse; width: 100%; font-size: 0.8125rem; }
  .tablefig th { font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-mute); text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--rule); }
  .tablefig td { font-family: var(--mono); padding: 0.45rem 0.75rem; border-bottom: 1px solid var(--rule-soft); white-space: nowrap; }
  .tablefig tr:last-child td { border-bottom: none; }
  .tablefig .provenance { border: 1px solid var(--rule); border-top: none; background: var(--paper-high); color: var(--ink-mute); }

  .checks { display: flex; flex-direction: column; gap: 0.75rem; max-width: var(--measure); }
  .check { border: 1px solid var(--rule); background: var(--paper-high); box-shadow: 3px 3px 0 color-mix(in srgb, var(--ink) 8%, transparent); }
  .check summary { display: flex; gap: 0.75rem; align-items: baseline; padding: 0.875rem 1rem; cursor: pointer; list-style: none; }
  .check summary::-webkit-details-marker { display: none; }
  .check summary:hover .q { color: var(--accent-deep); }
  .check .q-num { color: var(--accent-deep); font-size: 0.8125rem; }
  .check .q { font-weight: 500; }
  .check .a { padding: 0 1rem 0.875rem 2.5rem; color: var(--ink-mute); }
  .check[open] summary { border-bottom: 1px solid var(--rule-soft); margin-bottom: 0.75rem; }

  .readings { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .readings li { display: flex; flex-direction: column; gap: 0.2rem; border: 1px solid var(--rule); background: var(--paper-high); padding: 0.75rem 1rem; }
  .readings a { font-family: var(--mono); font-size: 0.8125rem; color: var(--ink); text-decoration: none; }
  .readings a:hover { color: var(--accent-deep); text-decoration: underline; }
  .r-note { font-size: 0.8125rem; color: var(--ink-mute); }

  .pathpager { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 3.5rem; padding-top: 1.25rem; border-top: 1px solid var(--rule); }
  .pp-left { display: flex; flex-direction: column; gap: 0.375rem; }
  .pp-work { font-family: var(--mono); font-size: 0.6875rem; color: var(--ink-mute); }
  .pp-prev { font-family: var(--mono); font-size: 0.75rem; color: var(--ink-mute); text-decoration: none; }
  .pp-prev:hover { color: var(--accent-deep); }
  .pp-next { display: inline-flex; flex-direction: column; gap: 0.25rem; align-items: flex-end; text-align: right; text-decoration: none; border: 1px solid var(--accent-deep); background: var(--paper-high); padding: 0.625rem 0.875rem; border-radius: 2px; }
  .pp-next:hover { background: var(--paper); }
  .pp-k { font-family: var(--mono); font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-mute); }
  .pp-t { font-family: var(--mono); font-size: 0.8125rem; color: var(--accent-deep); }
</style>
