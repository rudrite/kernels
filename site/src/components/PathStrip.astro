---
// The current path, always in reach: its ticks, the live mastery fraction,
// and the continue pointer, on every page. On /jax/* the strip is the JAX
// path; everywhere else it is the kernel track. ProgressKit paints all of it
// through the same data attributes the home pages use; without JS the strip
// still renders as a static map of the path.
import { PATH } from '../lib/path'
import { JAX_PATH } from '../data/jax/track'
import { XLA_PATH } from '../data/xla/track'
import { PT_PATH } from '../data/pytorch/track'
import { ALL_SERIES } from '../data/series'
import { seriesRefs } from '../lib/series'

// build format 'file' can surface index pages as /jax.html at render time.
// Workshop sub-pages (/gym/jax, /mistakes/xla, ...) carry their path's strip.
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/+$/, '') || '/'
const seg = current.split('/').filter(Boolean)
const pathId = seg[0] === 'gym' || seg[0] === 'mistakes' ? seg[1] : seg[0]
// On a series page the strip is that series; the shelf itself and unknown
// series ids keep the kernel track.
const onSeries = seg[0] === 'series' ? ALL_SERIES.find((s) => s.id === seg[1]) : undefined
const strip = onSeries
  ? {
      id: `sr-${onSeries.id}`,
      home: `/series/${onSeries.id}`,
      label: `${onSeries.title.toLowerCase()}, the series`,
      chapters: seriesRefs(onSeries),
      breakAt: 0,
    }
  : pathId === 'jax'
    ? { id: 'jax', home: '/jax', label: 'the jax path', chapters: JAX_PATH, breakAt: 9 }
    : pathId === 'xla'
      ? { id: 'xla', home: '/xla', label: 'the xla path', chapters: XLA_PATH, breakAt: 11 }
      : pathId === 'pytorch'
        ? { id: 'pytorch', home: '/pytorch', label: 'the pytorch path', chapters: PT_PATH, breakAt: 8 }
        : { id: 'kernels', home: '/', label: 'the path', chapters: PATH, breakAt: 10 }
const scoped = strip.id === 'kernels' ? '' : strip.id
const startLabel = onSeries ? 'start the series' : 'start the path'
---

<div class="path-strip">
  <div class="wrap strip-row">
    <a href={strip.home} class="mono-label strip-label">
      {strip.label} · <span data-path-progress={scoped}>0/{strip.chapters.length}</span>
    </a>
    <ol class="ticks" aria-label="Chapters">
      {
        strip.chapters.map((c) => (
          <li class={c.part === 'ii' && c.num === strip.breakAt ? 'part-break' : ''}>
            <a
              href={c.href}
              data-chapter-key={c.key}
              class={`tick ${current === c.href ? 'here' : ''}`}
              title={`${String(c.num).padStart(2, '0')} · ${c.title}`}
              aria-label={`Chapter ${c.num}: ${c.title}`}
            />
          </li>
        ))
      }
    </ol>
    <a class="mono-label strip-continue" data-continue={scoped} href={strip.home}>
      <span data-continue-label>{startLabel}</span>
    </a>
  </div>
</div>

<style>
  .path-strip { background: var(--paper-high); border-bottom: 1px solid var(--rule); }
  .strip-row { display: flex; align-items: center; gap: 1.25rem; padding-block: 0.4rem; }
  .strip-label { text-decoration: none; color: var(--ink-mute); white-space: nowrap; }
  .strip-label:hover { color: var(--copper-deep); }

  .ticks { display: flex; align-items: center; gap: 0.25rem; list-style: none; margin: 0; padding: 0; flex: 1; min-width: 0; }
  .ticks li { display: flex; }
  .ticks li.part-break { margin-left: 0.75rem; }
  .tick {
    display: block; width: 0.875rem; height: 0.5rem; border-radius: 1px;
    border: 1px solid var(--rule); background: var(--paper);
  }
  .tick:hover { border-color: var(--copper-deep); }
  .tick.here { outline: 2px solid var(--copper-deep); outline-offset: 1px; }
  :global(.tick.p-done) { background: var(--copper-deep); border-color: var(--copper-deep); }

  .strip-continue { text-decoration: none; color: var(--copper-deep); white-space: nowrap; }
  .strip-continue:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .strip-continue { display: none; }
  }
  @media (max-width: 640px) {
    .ticks { display: none; }
    .strip-row { justify-content: space-between; }
    .strip-continue { display: inline; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  }
</style>
