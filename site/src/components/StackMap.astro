---
// The map: the hourglass with its cells, every unit on the site linked from
// the level it belongs to. Mastery state rides on the same data attributes
// the path rows use, so ProgressKit paints this with no new code. The four
// courses are routes drawn over the cells; picking one dims the rest.
import { LEVELS, ROUTES, routesAt, unitsAt, type MapLevel, type MapSide } from '../data/map'

interface Props {
  /** The reader's current cell, lit on the map. */
  here?: { level: number; side: MapSide }
}
const { here } = Astro.props
const pad = (n: number) => String(n).padStart(2, '0')

const columns = (level: MapLevel): { side: MapSide; label: string }[] => [
  level.left,
  { side: 'waist', label: level.waist ?? '' },
  level.right,
]

// How far each level's cells pull in from the page edges, so the hourglass
// narrows toward the waist and reopens under it. Chrome only: the cells and
// their contents are unchanged (ADR 0003).
const TAPER = ['0', '5%', '12%', '12%', '6%', '3%', '1%', '0']
---

<div class="map">
  <div class="routes" role="group" aria-label="The four courses, drawn over the map">
    {
      ROUTES.map((r) => (
        <div class="plate route">
          <button type="button" class="route-btn" data-route-btn={r.id} aria-pressed="false">
            <span class="rb-label">{r.label}</span>
            <span class="rb-meta meas"><span data-path-progress={r.progress}>0/{r.units.length}</span> chapters</span>
          </button>
          <span class="route-note">{r.note}</span>
          <a class="route-go mono-label" href={r.href}>enter the course →</a>
        </div>
      ))
    }
  </div>

  <div class="spine-wrap">
    <svg class="spine" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <path vector-effect="non-scaling-stroke" d="M 4 1 L 42 32 L 42 68 L 4 99" />
      <path vector-effect="non-scaling-stroke" d="M 96 1 L 70 32 L 70 68 L 96 99" />
      <path class="mid" vector-effect="non-scaling-stroke" d="M 56 0 L 56 100" />
    </svg>
  <ol class="levels">
    {
      LEVELS.map((level) => (
        <>
          <li class="row" style={`--taper:${TAPER[level.level] ?? '0'}`}>
            <div class="lv">
              <span class="lv-n meas bloom">L{level.level}</span>
              <span class="lv-t">{level.title}</span>
            </div>
            <div class="cells">
              {columns(level).map((col) => {
                const units = unitsAt(level.level, col.side)
                const lit = here && here.level === level.level && here.side === col.side
                if (!units.length && !col.label) return <div class="cell gone" aria-hidden="true" />
                return (
                  <div
                    class={`plate cell ${units.length ? '' : 'empty'} ${lit ? 'here' : ''}`}
                    data-side={col.side}
                    data-routes={routesAt(level.level, col.side).join(' ')}
                  >
                    <span class="c-head mono-label">{col.label}</span>
                    {units.length > 0 ? (
                      <ul>
                        {units.map((u) => (
                          <li>
                            <a class="u" href={u.href} data-chapter-key={u.key}>
                              <span class="u-k">{u.route} {pad(u.num)}</span>
                              <span class="u-t">{u.title}</span>
                              <span class="u-f meas" data-work-frac={u.key} />
                            </a>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <span class="c-none">nothing here yet</span>
                    )}
                  </div>
                )
              })}
            </div>
          </li>
          {level.seam && (
            <li class="seam">
              <span class="led" data-state="active" />
              <span class="mono-label bloom">{level.seam}</span>
            </li>
          )}
        </>
      ))
    }
  </ol>
  </div>
</div>

<script>
  // Picking a route dims every cell it does not pass through; picking it
  // again clears. The map reads fine with the script absent.
  const map = document.querySelector<HTMLElement>('.map')
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-route-btn]'))
  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-route-btn')!
      const on = map?.dataset.route !== id
      if (map) {
        if (on) map.dataset.route = id
        else delete map.dataset.route
      }
      for (const b of buttons) b.setAttribute('aria-pressed', String(on && b === btn))
    })
  }
</script>

<style>
  .map { --dim: 0.28; }

  .routes { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.75rem; margin-bottom: 2rem; }
  @media (max-width: 1000px) { .routes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .routes { grid-template-columns: minmax(0, 1fr); } }
  .route { display: flex; flex-direction: column; gap: 0.3rem; padding: 0.8rem 0.95rem; }
  .route-btn { display: flex; flex-direction: column; gap: 0.25rem; align-items: flex-start; background: none; border: none; padding: 0; cursor: pointer; text-align: left; color: inherit; font: inherit; }
  .rb-label { font-family: var(--grot); font-weight: 700; font-size: 1.0625rem; letter-spacing: -0.015em; }
  .route-btn:hover .rb-label, .route-btn[aria-pressed='true'] .rb-label { color: var(--accent); text-shadow: var(--bloom); }
  .rb-meta { font-family: var(--mono); font-size: 0.6875rem; color: var(--ink-faint); }
  .route-note { font-size: 0.8125rem; color: var(--ink-mute); }
  .route-go { text-decoration: none; color: var(--accent-deep); }
  .route-go:hover { color: var(--accent); text-shadow: var(--bloom); }
  .route:has(.route-btn[aria-pressed='true']) { border-color: var(--accent); }

  /* the spine: the hourglass drawn as a lit trace behind the cells */
  .spine-wrap { position: relative; }
  .spine { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .spine path { fill: none; stroke: var(--accent-deep); stroke-width: 1.25; opacity: 0.5; }
  .spine .mid { stroke: var(--edge-hi); opacity: 0.5; stroke-dasharray: 2 5; }
  @media (prefers-color-scheme: dark) {
    .spine path { stroke: var(--accent); opacity: 0.42; filter: drop-shadow(0 0 6px rgba(217, 140, 95, 0.55)); }
    .spine .mid { stroke: var(--edge-hi); filter: none; }
  }

  .levels { list-style: none; margin: 0; padding: 0; position: relative; }
  .row { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 1.25rem; align-items: start; padding-block: 0.55rem; }
  .lv { display: flex; flex-direction: column; gap: 0.2rem; }
  .lv-n { font-family: var(--mono); font-size: 1.5rem; line-height: 1; color: var(--accent); }
  .lv-t { font-family: var(--mono); font-size: 0.75rem; color: var(--ink-faint); }

  .cells { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.6rem; margin-inline: var(--taper, 0); }
  .cell { padding: 0.5rem 0.65rem; min-width: 0; }
  .cell.gone { border: none; background: none; box-shadow: none; background-image: none; }
  .cell.empty { background-image: none; border-style: dashed; }
  .cell.here { border-color: var(--accent); }
  .c-head { display: block; font-size: 0.625rem; letter-spacing: 0.12em; color: var(--ink-faint); }
  .cell[data-side='waist'] .c-head { color: var(--accent); text-shadow: var(--bloom); }
  .c-none { font-family: var(--mono); font-size: 0.6875rem; color: var(--ink-faint); }
  .cell ul { list-style: none; margin: 0.4rem 0 0; padding: 0; }
  .u { display: flex; align-items: baseline; gap: 0.5rem; padding: 0.1rem 0; text-decoration: none; color: var(--ink); font-size: 0.8125rem; }
  .u:hover { color: var(--accent); }
  .u-k { font-family: var(--mono); font-size: 0.625rem; color: var(--ink-faint); white-space: nowrap; }
  .u-t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .u-f { font-family: var(--mono); font-size: 0.625rem; color: var(--ink-faint); }
  :global(.u.p-done) .u-f { color: var(--pass); }
  :global(.u.p-done) .u-k { color: var(--pass); }

  /* the seam: a lit dashed bus with its indicator */
  .seam { display: flex; align-items: center; gap: 0.9rem; margin: 0.5rem 0 0.5rem 8.25rem; border-top: 2px dashed var(--accent-deep); padding-top: 0.55rem; }
  .seam .mono-label { color: var(--accent); }

  /* the route overlay: one rule per course, the ids being a closed set */
  .map[data-route='kernels'] .cell:not(.gone):not([data-routes~='kernels']),
  .map[data-route='jax'] .cell:not(.gone):not([data-routes~='jax']),
  .map[data-route='xla'] .cell:not(.gone):not([data-routes~='xla']),
  .map[data-route='pytorch'] .cell:not(.gone):not([data-routes~='pytorch']) { opacity: var(--dim); }
  .map[data-route='kernels'] .cell[data-routes~='kernels'],
  .map[data-route='jax'] .cell[data-routes~='jax'],
  .map[data-route='xla'] .cell[data-routes~='xla'],
  .map[data-route='pytorch'] .cell[data-routes~='pytorch'] { border-color: var(--accent); }

  @media (max-width: 860px) {
    .spine { display: none; }
    .row { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
    .cells { grid-template-columns: minmax(0, 1fr); margin-inline: 0; }
    .cell.gone { display: none; }
    .lv { flex-direction: row; align-items: baseline; gap: 0.625rem; }
    .seam { margin-left: 0; }
  }
</style>
