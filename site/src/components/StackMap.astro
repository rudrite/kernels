---
// The signature element: the lowering path as the site's map, which is also
// the path itself: layer rows are chapters 01-09 in top-to-bottom order,
// stage chips are chapters 10-15 pinned to the layer they teach, and every
// entry wears the reader's own mastery fraction. The XLA-to-Pallas gap is
// drawn as what it is: empty.
import { LAYERS, stagesForLayer } from '../data/track'

const chapterNum = (layerIdx: number) => String(layerIdx + 1).padStart(2, '0')
const stageChapter = (num: number) => String(10 + num).padStart(2, '0')
---

<ol class="stack" aria-label="The compilation stack, with curriculum stages pinned to their layers">
  {
    LAYERS.map((layer, li) => {
      const pinned = stagesForLayer(layer.id)
      return (
        <li class={`row kind-${layer.kind}`}>
          <span class="rail" aria-hidden="true">
            <span class="node" />
          </span>
          <div class="cell label-cell">
            <a class="layer-link" href={`/l/${layer.id}`} data-chapter-key={`l:${layer.id}`}>
              <span class="ch-line"><span class="ch-num">ch {chapterNum(li)}</span><span class="ch-frac meas" data-work-frac={`l:${layer.id}`}></span></span>
              <span class="layer-label">{layer.label}</span>
            </a>
          </div>
          <div class="cell desc-cell"><a class="desc-link" href={`/l/${layer.id}`}>{layer.desc}</a></div>
          <div class="cell stages-cell">
            {pinned.map((s) => (
              <a class="stage-chip" href={`/s/${s.id}`} data-chapter-key={`s:${s.id}`}>
                <span class="led" data-state={s.gate.state === 'queued' ? undefined : s.gate.state} />
                <span class="chip-num">ch {stageChapter(s.num)}</span>
                <span class="chip-title">{s.title}</span>
                <span class="ch-frac meas" data-work-frac={`s:${s.id}`}></span>
              </a>
            ))}
          </div>
        </li>
      )
    })
  }
</ol>

<style>
  .stack { list-style: none; padding: 0; border-block: 1px solid var(--rule); }
  .row {
    display: grid;
    grid-template-columns: 2rem 11rem minmax(14rem, 1fr) minmax(15rem, 22rem);
    gap: 0 1.25rem;
    align-items: center;
    padding-block: 1rem;
  }
  .row + .row { border-top: 1px solid var(--rule-soft); }
  .row:hover { background: var(--paper-high); }

  /* the rail: one continuous conductor down the left edge */
  .rail { position: relative; height: 100%; min-height: 2.75rem; display: block; }
  .rail::before {
    content: ''; position: absolute; left: 50%; top: -1.05rem; bottom: -1.05rem;
    width: 1px; background: var(--ink-mute); opacity: 0.5;
  }
  .row:first-child .rail::before { top: 50%; }
  .row:last-child .rail::before { bottom: 50%; }
  .node {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: 7px; height: 7px; background: var(--paper); border: 1.5px solid var(--ink);
  }

  .layer-link { display: inline-flex; flex-direction: column; gap: 0.2rem; text-decoration: none; }
  .layer-label { font-family: var(--mono); font-weight: 500; font-size: 0.9375rem; letter-spacing: 0.02em; }
  .ch-line { display: inline-flex; gap: 0.6rem; align-items: baseline; }
  .ch-num { font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.09em; text-transform: uppercase; color: var(--copper-deep); }
  .ch-frac { font-size: 0.6875rem; color: var(--ink-mute); }
  [data-chapter-key].p-done .ch-frac { color: var(--pass); }
  .layer-link:hover .layer-label { color: var(--copper-deep); }
  .desc-cell { font-size: 0.9375rem; max-width: 40ch; }
  .desc-link { color: var(--ink-mute); text-decoration: none; }
  .desc-link:hover { color: var(--ink); }

  .stages-cell { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: flex-end; }
  .stage-chip {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.02em;
    border: 1px solid var(--ink-mute); border-radius: 2px;
    padding: 0.375rem 0.625rem; text-decoration: none; background: var(--paper-high);
  }
  .stage-chip:hover { border-color: var(--copper-deep); color: var(--copper-deep); }
  .chip-num { font-weight: 500; color: var(--copper-deep); font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .chip-title { color: var(--ink); }
  .stage-chip:hover .chip-title { color: var(--copper-deep); }

  /* the gap row */
  .kind-gap { background: repeating-linear-gradient(-45deg, transparent, transparent 6px, var(--rule-soft) 6px, var(--rule-soft) 7px); }
  .kind-gap:hover { background-color: transparent; }
  .kind-gap .node { border-style: dashed; border-color: var(--copper-deep); }
  .kind-gap .layer-label { color: var(--copper-deep); font-style: normal; }
  .kind-gap .rail::before { background: var(--copper-deep); opacity: 0.6; }

  /* the ICI row: the one horizontal move in a vertical map */
  .kind-ici { border-top: 1px solid var(--rule); }
  .kind-ici .node { border-radius: 50%; }
  .kind-ici .layer-label { letter-spacing: 0.08em; }

  @media (max-width: 860px) {
    .row { grid-template-columns: 1.25rem 1fr; grid-template-areas: 'rail label' 'rail desc' 'rail stages'; row-gap: 0.375rem; }
    .rail { grid-area: rail; }
    .label-cell { grid-area: label; }
    .desc-cell { grid-area: desc; }
    .stages-cell { grid-area: stages; justify-content: flex-start; margin-top: 0.25rem; }
  }
</style>
