---
import Base from '../../layouts/Base.astro'
import BlockDiagram from '../../components/BlockDiagram.astro'
import { XLA_CHAPTERS, XLA_PATH } from '../../data/xla/track'
import { XLA_DIAGRAMS } from '../../data/xla/diagrams'

const pad = (n: number) => String(n).padStart(2, '0')
const partI = XLA_CHAPTERS.filter((c) => c.part === 'i')
const partII = XLA_CHAPTERS.filter((c) => c.part === 'ii')
const stack = XLA_DIAGRAMS['xla-stack']!

const OUTCOMES = [
  { n: '01', h: 'Read any dump on sight', p: 'passes, fusions, layouts, all from --xla_dump_to' },
  { n: '02', h: 'Name every layer of the seam', p: 'PJRT, IFRT, and what swaps where' },
  { n: '03', h: 'Explain single-controller', p: 'why Pathways changes the fleet, not your JAX' },
]
---

<Base
  title="Rudrite Kernels · the XLA path · learn how the compiler works"
  description="A mastery course through XLA: fourteen chapters from the PJRT seam through the pass pipeline to IFRT, multi-controller JAX, and Pathways, grounded in real dumps and the public source tree."
>
  <section class="wrap hero">
    <div class="hero-copy">
      <p class="mono-label kicker">a mastery course · the xla path · through the compiler</p>
      <h1>Learn how XLA works.</h1>
      <p class="lede">
        The JAX path treats the compiler as a black box that keeps its promises. This path opens
        it: the seam every framework enters through, the IR where two hundred passes work, the
        floors where backends part ways, and the runtime stack above that decides who controls
        the fleet.
      </p>
      <div class="cta-row">
        <a class="cta primary" href={XLA_PATH[0]!.href} data-continue="xla"><span data-continue-label>start the path → chapter 1</span></a>
        <a class="cta" href="/jax">the jax path</a>
        <a class="cta" href="/">the kernel path</a>
      </div>
      <p class="stat-line">
        your progress <span class="meas" data-path-progress="xla">0/{XLA_PATH.length}</span> chapters
      </p>
      <div class="your-bar" aria-hidden="true"><i data-path-progress-bar="xla"></i></div>
      <div class="outcome-strip">
        {OUTCOMES.map((o) => (
          <div><span class="meas onum">{o.n}</span> <strong>{o.h}</strong><span class="op"> · {o.p}</span></div>
        ))}
      </div>
    </div>
    <div class="hero-instrument">
      <figure class="panel machinefig">
        <figcaption class="provenance top">{stack.caption}</figcaption>
        <BlockDiagram spec={stack} />
      </figure>
    </div>
  </section>

  <section class="wrap ledger">
    <div class="part">
      <header class="part-head">
        <span class="mono-label">part i · the compiler</span>
        <p>From the PJRT seam to the codegen floors: how a StableHLO program becomes an executable, with every decision visible in a dump.</p>
      </header>
      <ol class="rows" start={1}>
        {
          partI.map((c) => (
            <li>
              <a href={`/xla/${c.id}`} data-chapter-key={`xla:${c.id}`}>
                <span class="row-num">ch {pad(c.num)}</span>
                <span class="row-body">
                  <span class="row-title">{c.title}</span>
                  <span class="row-lede">{c.lede}</span>
                </span>
                <span class="row-frac meas" data-work-frac={`xla:${c.id}`} />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="part">
      <header class="part-head">
        <span class="mono-label">part ii · the runtime</span>
        <p>IFRT, multi-controller JAX, single-controller Pathways, and a capstone where the dump is the referee.</p>
      </header>
      <ol class="rows" start={11}>
        {
          partII.map((c) => (
            <li>
              <a href={`/xla/${c.id}`} data-chapter-key={`xla:${c.id}`}>
                <span class="row-num">ch {pad(c.num)}</span>
                <span class="row-body">
                  <span class="row-title">{c.title}</span>
                  <span class="row-lede">{c.lede}</span>
                </span>
                <span class="row-frac meas" data-work-frac={`xla:${c.id}`} />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="promises">
    <div class="wrap promise-grid">
      <div class="p-item">
        <span class="mono-label p-head">the grounding rule</span>
        <p>
          Facts are anchored to the public source tree at a verified commit, and readings are
          public only: openxla.org, the GitHub tree, the GSPMD and Pathways papers. Every cited
          source path exists; every reading URL answered when this path was built.
        </p>
      </div>
      <div class="p-item">
        <span class="mono-label p-head">the honesty rule</span>
        <p>
          The pass pipeline shown is a real dump from a real compile on this machine (jax 0.4.38,
          CPU, 2026-07-27), and the HLO excerpts are the compiler's own output with paths
          shortened. Closed layers stay marked closed: libtpu below, the Pathways runtime above.
        </p>
      </div>
      <div class="p-item">
        <span class="mono-label p-head">the neighbors</span>
        <p>
          The <a href="/jax">JAX path</a> teaches the language that feeds this compiler; the
          <a href="/">kernel path</a> lives on the floor where XLA stops. The three
          cross-reference, and the <a href="/gym/xla">xla gym floor</a> drills what these
          chapters teach.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 3rem; align-items: center; padding-block: clamp(2.5rem, 6vw, 4rem) 2rem; }
  @media (max-width: 1100px) { .hero { grid-template-columns: minmax(0, 1fr); } }
  .kicker { display: block; margin-bottom: 1.25rem; color: var(--accent-deep); }
  h1 { font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1.05; font-weight: 600; letter-spacing: -0.01em; }
  .lede { margin-top: 1.25rem; font-size: 1.125rem; max-width: 48ch; }
  .cta-row { display: flex; gap: 1rem; margin-top: 1.75rem; flex-wrap: wrap; }
  .cta { font-family: var(--mono); font-size: 0.8125rem; text-decoration: none; border: 1px solid var(--ink-mute); padding: 0.625rem 1rem; border-radius: 2px; color: var(--ink); background: var(--paper-high); }
  .cta:hover { border-color: var(--accent-deep); color: var(--accent-deep); }
  .cta.primary { border-color: var(--accent-deep); color: var(--accent-deep); }
  .stat-line { margin-top: 1.5rem; font-family: var(--mono); font-size: 0.8125rem; color: var(--ink-mute); }
  .your-bar { height: 2px; background: var(--rule-soft); margin-top: 0.5rem; max-width: 24rem; }
  .your-bar i { display: block; height: 100%; width: 0; background: var(--pass); }
  .outcome-strip { margin-top: 1.5rem; display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.875rem; }
  .outcome-strip .onum { color: var(--accent-deep); font-size: 0.75rem; }
  .outcome-strip .op { color: var(--ink-mute); }
  .machinefig { margin: 0; }
  .machinefig .top { border-top: none; border-bottom: 1px solid var(--panel-rule); }

  .ledger { display: grid; grid-template-columns: 1fr; gap: 2.5rem; padding-block: 1.5rem 2.5rem; }
  .part-head { display: flex; align-items: baseline; gap: 1.25rem; border-top: 1px solid var(--rule); padding-top: 1rem; margin-bottom: 0.75rem; flex-wrap: wrap; }
  .part-head .mono-label { color: var(--accent-deep); }
  .part-head p { color: var(--ink-mute); font-size: 0.9375rem; max-width: 62ch; }
  .rows { list-style: none; margin: 0; padding: 0; }
  .rows a { display: flex; align-items: baseline; gap: 1.25rem; padding: 0.875rem 0.5rem; border-bottom: 1px solid var(--rule-soft); text-decoration: none; color: inherit; }
  .rows a:hover { background: var(--paper-high); }
  .rows a:hover .row-title { color: var(--accent-deep); }
  .row-num { font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-deep); flex: 0 0 3.5rem; }
  .row-body { display: flex; flex-direction: column; gap: 0.2rem; flex: 1; min-width: 0; }
  .row-title { font-family: var(--serif); font-weight: 600; font-size: 1.1875rem; }
  .row-lede { font-size: 0.875rem; color: var(--ink-mute); max-width: 72ch; }
  .row-frac { font-family: var(--mono); font-size: 0.75rem; color: var(--ink-mute); white-space: nowrap; }
  :global(.rows a.p-done) .row-frac { color: var(--pass); }

  .promises { background: var(--paper-high); border-top: 1px solid var(--rule); padding-block: 2.5rem 3rem; }
  .promise-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; }
  @media (max-width: 960px) { .promise-grid { grid-template-columns: minmax(0, 1fr); } }
  .p-head { display: block; margin-bottom: 0.625rem; color: var(--accent-deep); }
  .p-item p { font-family: var(--serif); font-size: 0.9875rem; line-height: 1.65; color: var(--ink); }
  .p-item a { color: var(--accent-deep); }
</style>
