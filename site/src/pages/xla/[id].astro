---
import { Code } from 'astro:components'
import Base from '../../layouts/Base.astro'
import Rich from '../../components/Rich.astro'
import MlirCode from '../../components/MlirCode.astro'
import SectionHead from '../../components/SectionHead.astro'
import ReadingRails from '../../components/ReadingRails.astro'
import MasteryWork from '../../components/MasteryWork.astro'
import LessonList from '../../components/LessonList.astro'
import { lessonsOf } from '../../data/lessons'
import BlockDiagram from '../../components/BlockDiagram.astro'
import LabCard from '../../components/LabCard.astro'
import Exhibit from '../../components/Exhibit.astro'
import PipelineStepper from '../../exhibits/PipelineStepper'
import CollectivePicker from '../../exhibits/CollectivePicker'
import CodeWalk from '../../exhibits/CodeWalk'
import { highlightLines } from '../../lib/highlight'
import { walk as pjrtMockWalk } from '../../data/walks/pjrt-mock'
import { walk as ifrtAdapterWalk } from '../../data/walks/ifrt-adapter'
import { XLA_CHAPTERS, XLA_PATH, xlaChapterAt, type XlaChapter } from '../../data/xla/track'
import { XLA_DIAGRAMS } from '../../data/xla/diagrams'
import type { Lab } from '../../data/track'

const INSTRUMENTS: Record<string, { d: string; t: string; p: string }> = {
  spmd: {
    d: 'EX·16',
    t: 'the collective the partitioner chose',
    p: 'six sharding combinations compiled on eight devices · the collectives are read out of the module, not predicted',
  },
  pipeline: {
    d: 'EX·15',
    t: 'the pass pipeline, stepped',
    p: 'twenty steps from one real compile · scrub the pipeline, watch the reruns, and find the watershed',
  },
}

const COLAB = 'https://colab.research.google.com/github/rudrite/kernels/blob/main/'
const lab = (designator: string, title: string, time: string, hardware: string, file: string): Lab => ({
  designator, title, time, hardware, colab: COLAB + file, notebook: file,
})
// One runnable lab per chapter that has one; the mastery ledger's labs
// auto-rule checks off when the card's mark-as-run is ticked.
const LABS: Record<string, Lab[]> = {
  pipeline: [lab('LAB·X1', 'Read your own dump', '~1.5 h', 'any machine', 'labs/xla/lab-x1-read-your-dump.ipynb')],
  fusion: [
    lab('LAB·X2', 'The TPU pipeline, dumped', '~2 h', 'Colab TPU', 'labs/xla/lab-x2-tpu-pipeline.ipynb'),
    lab('LAB·X4', 'Two loose ends', '~1 h', 'Colab TPU', 'labs/xla/lab-x4-two-loose-ends.ipynb'),
  ],
  spmd: [lab('LAB·X3', 'Collectives in the lowering', '~1.5 h', 'any machine', 'labs/xla/lab-x3-collectives-in-the-lowering.ipynb')],
  interfaces: [
    lab('LAB·X5', 'The mock device', '~1.5 h', 'any machine', 'labs/xla/lab-x5-mock-pjrt-plugin.ipynb'),
    lab('LAB·X7', 'The dry-run device', '~1.5 h', 'any machine', 'labs/xla/lab-x7-the-dry-run-device.ipynb'),
  ],
  collectives: [lab('LAB·X6', 'Collectives on a mock GPU', '~1.5 h', 'any machine', 'labs/xla/lab-x6-collectives-on-a-mock-gpu.ipynb')],
}

export function getStaticPaths() {
  return XLA_CHAPTERS.map((chapter) => ({ params: { id: chapter.id }, props: { chapter } }))
}

interface Props {
  chapter: XlaChapter
}
const { chapter } = Astro.props
const key = `xla:${chapter.id}`
const { prev, next } = xlaChapterAt(key)
const pad = (n: number) => String(n).padStart(2, '0')
const slug = (h: string) => h.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
const partLabel = chapter.part === 'i' ? 'part i, the compiler' : 'part ii, the runtime'
// Presentation-owned diagram slots for chapters whose data carries none.
const EXTRA_DIAGRAMS: Record<string, { id: string; after: number }> = {
  'layout-memory': { id: 'xla-layout', after: 0 },
  hlo: { id: 'xla-hlo', after: 0 },
  fusion: { id: 'xla-fusion', after: 0 },
  codegen: { id: 'xla-codegen', after: 0 },
  autotuning: { id: 'xla-autotuning', after: 0 },
  mcjax: { id: 'xla-dispatch', after: 1 },
  capstone: { id: 'xla-evidence', after: 0 },
  pjrt: { id: 'xla-pjrt', after: 0 },
  spmd: { id: 'xla-spmd', after: 1 },
  collectives: { id: 'xla-collective-async', after: 1 },
}
const slot = chapter.diagram ?? EXTRA_DIAGRAMS[chapter.id]
const diagram = slot ? XLA_DIAGRAMS[slot.id] : undefined

// Line-by-line code walks for chapters that carry them.
const WALKS: Record<string, (typeof pjrtMockWalk)[]> = {
  interfaces: [pjrtMockWalk, ifrtAdapterWalk],
}
const chapterWalks = await Promise.all(
  (WALKS[chapter.id] ?? []).map(async (w) => ({ walk: w, lines: await highlightLines(w.code, w.lang) })),
)
---

<Base
  title={`${chapter.title} · the XLA path · Rudrite Kernels`}
  description={chapter.lede}
>
  <section class="chapter-head">
    <div class="wrap">
      <p class="mono-label kicker">the xla path · chapter {pad(chapter.num)} of {XLA_PATH.length} · {partLabel}</p>
      <h1>{chapter.title}</h1>
      <p class="lede"><Rich text={chapter.lede} self={`/xla/${chapter.id}`} /></p>
      <p class="goal"><span class="mono-label">the goal</span> <Rich text={chapter.goal} self={`/xla/${chapter.id}`} /></p>
    </div>
  </section>

  <div class="wrap layout">
    <aside class="side">
      <nav class="pathmap" aria-label="The XLA path">
        <span class="mono-label toc-head">the xla path</span>
        <ol>
          {
            XLA_PATH.map((c) => (
              <li class={`${c.num === 11 ? 'part-break' : ''} ${c.key === key ? 'here' : ''}`}>
                <a href={c.href} data-chapter-key={c.key}>
                  <span class="pm-num">{pad(c.num)}</span>
                  <span class="pm-title">{c.title}</span>
                  <span class="pm-frac meas" data-work-frac={c.key} />
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <nav class="toc" aria-label="On this page">
        <span class="mono-label toc-head">on this page</span>
        <ol>
          {chapter.sections.map((sec) => <li><a href={`#${slug(sec.h)}`}>{sec.h}</a></li>)}
          {chapterWalks.length > 0 && <li><a href="#walks">guided walks</a></li>}
        </ol>
      </nav>
    </aside>

    <article class="main">
      <MasteryWork chapterKey={key} />

      {
        chapter.sections.map((sec, si) => (
          <section class="block prose">
            <SectionHead id={slug(sec.h)} eyebrow={`§ ${pad(si + 1)}`} title={sec.h.charAt(0).toUpperCase() + sec.h.slice(1)} />
            {sec.ps.map((p) =>
              p.startsWith('>> ') ? (
                <blockquote class="pull">{p.slice(3)}</blockquote>
              ) : (
                <p class="theory">
                  <Rich text={p} self={`/xla/${chapter.id}`} />
                </p>
              ),
            )}
            {sec.code && (
              <figure class="panel codefig">
                <figcaption class="provenance top">{sec.code.caption}</figcaption>
                <div class="codebody">
                  {sec.code.lang === 'mlir' ? (
                    <MlirCode code={sec.code.text} />
                  ) : (
                    <Code code={sec.code.text} lang={sec.code.lang === 'text' ? 'txt' : sec.code.lang} theme="vesper" />
                  )}
                </div>
              </figure>
            )}
            {diagram && slot!.after === si && (
              <figure class="panel codefig">
                <figcaption class="provenance top">{diagram.caption}</figcaption>
                <BlockDiagram spec={diagram} />
              </figure>
            )}
          </section>
        ))
      }

      {
        chapterWalks.length > 0 && (
          <section class="block">
            <SectionHead id="walks" eyebrow="line by line, at your pace" title="Guided walks" />
            <div class="ex-stack">
              {chapterWalks.map((w) => (
                <Exhibit designator={`WALK·${w.walk.id}`} title={w.walk.title} provenance={w.walk.id === 'pjrt-mock' ? 'code verbatim from LAB·X5, trimmed to the load-bearing functions · step with the buttons or j/k' : 'excerpts from xla/python/pjrt_ifrt at openxla/xla 881f236, trimmed where marked · step with the buttons or j/k'}>
                  <CodeWalk lines={w.lines} steps={w.walk.steps} title={w.walk.title} client:visible />
                </Exhibit>
              ))}
            </div>
          </section>
        )
      }

      {
        lessonsOf(key).length > 0 && (
          <section class="block">
            <SectionHead id="lessons" eyebrow="go deeper, in order" title="Lessons" />
            <LessonList unit={key} />
          </section>
        )
      }

      <section class="block">
        <SectionHead id="readings" eyebrow="assigned" title="Readings" />
        <ul class="readings">
          {
            chapter.readings.map((r) => (
              <li>
                <a href={r.url} target="_blank" rel="noopener">{r.label} ↗</a>
                <span class="r-note">{r.note}</span>
              </li>
            ))
          }
        </ul>
      </section>

      {
        LABS[chapter.id] && (
          <section class="block" id="labs">
            <SectionHead id="labs-head" eyebrow="runnable" title="Labs" />
            <div class="labgrid">
              {LABS[chapter.id]!.map((l) => (
                <LabCard lab={l} />
              ))}
            </div>
          </section>
        )
      }

      {
        INSTRUMENTS[chapter.id] && (
          <section class="block" id="instruments">
            <SectionHead id="instruments-head" eyebrow="live" title="Instrument" />
            <Exhibit designator={INSTRUMENTS[chapter.id]!.d} title={INSTRUMENTS[chapter.id]!.t} provenance={INSTRUMENTS[chapter.id]!.p}>
              {chapter.id === 'spmd' ? <CollectivePicker client:visible /> : <PipelineStepper client:visible />}
            </Exhibit>
          </section>
        )
      }

      <nav class="pathpager" aria-label="The XLA path">
        <div class="pp-left">
          {prev ? <a class="pp-prev" href={prev.href}>← ch {pad(prev.num)} · {prev.title}</a> : <a class="pp-prev" href="/xla">← the xla path</a>}
          <span class="pp-work">this chapter's work · <span data-work-frac={key}>·</span></span>
        </div>
        {
          next ? (
            <a class="pp-next" href={next.href}>
              <span class="pp-k">next on the path</span>
              <span class="pp-t">ch {pad(next.num)} · {next.title} →</span>
            </a>
          ) : (
            <a class="pp-next" href="/">
              <span class="pp-k">the xla path ends here</span>
              <span class="pp-t">the kernel path holds the floor below →</span>
            </a>
          )
        }
      </nav>
    </article>

    <aside class="right">
      <div class="rail">
        <div>
          <span class="rail-head">reading progress</span>
          <span class="progress-num meas">0%</span>
          <div class="progress-bar"><i></i></div>
        </div>
        <div>
          <span class="rail-head">this chapter</span>
          <div class="card">
            <div class="row"><span class="k">chapter</span><span>{pad(chapter.num)} of {XLA_PATH.length}</span></div>
            <div class="row"><span class="k">part</span><span>{partLabel}</span></div>
            <div class="row"><span class="k">readings</span><span>{chapter.readings.length} assigned</span></div>
          </div>
        </div>
        <div>
          <span class="rail-head">part of</span>
          <ul>
            <li><a href="/xla">the xla path · fifteen chapters</a></li>
            <li><a href="/jax">the jax path · the layer above</a></li>
            <li><a href="/">the kernel path · the floor below</a></li>
          </ul>
        </div>
      </div>
    </aside>
  </div>
  <ReadingRails />
</Base>

<style>
  .layout { display: grid; grid-template-columns: 13.5rem minmax(0, 1fr) 13rem; gap: 3rem; padding-block: 2.5rem; }
  .side, .right { position: sticky; top: 2rem; align-self: start; }
  @media (max-width: 1240px) { .layout { grid-template-columns: 13.5rem minmax(0, 1fr); } .right { display: none; } }
  @media (max-width: 960px) { .layout { grid-template-columns: minmax(0, 1fr); } .side { display: none; } }

  .chapter-head { padding-block: 2rem 2.25rem; background: var(--paper-high); border-bottom: 1px solid var(--rule); }
  .chapter-head .kicker { color: var(--accent-deep); margin-bottom: 0.875rem; }
  .chapter-head h1 { font-size: clamp(1.875rem, 4.5vw, 2.75rem); font-weight: 600; letter-spacing: -0.01em; }
  .chapter-head .lede { margin-top: 0.75rem; font-size: 1.1875rem; color: var(--ink-mute); max-width: 62ch; }
  .chapter-head .goal { margin-top: 0.875rem; font-size: 0.9375rem; color: var(--ink); max-width: 70ch; border-left: 3px solid var(--copper-deep); padding-left: 0.875rem; }
  .chapter-head .goal .mono-label { color: var(--copper-deep); margin-right: 0.5rem; }

  .block { margin-top: 2.5rem; }
  .theory { margin-bottom: 1em; }

  .pull {
    margin: 1.25rem 0; padding: 0.25rem 0 0.25rem 1.125rem;
    border-left: 3px solid var(--copper-deep);
    font-family: var(--serif); font-style: italic; font-size: 1.1875rem; line-height: 1.5;
    color: var(--ink);
  }

  .pathmap ol { list-style: none; margin: 0.5rem 0 0; padding: 0; }
  .pathmap li.part-break { margin-top: 0.625rem; padding-top: 0.625rem; border-top: 1px solid var(--rule-soft); }
  .pathmap a { display: flex; align-items: baseline; gap: 0.5rem; padding: 0.22rem 0; text-decoration: none; color: var(--ink-mute); font-size: 0.8125rem; }
  .pathmap a:hover { color: var(--accent-deep); }
  .pathmap li.here a { color: var(--accent-deep); font-weight: 500; }
  .pm-num { font-family: var(--mono); font-size: 0.6875rem; color: var(--accent-deep); }
  .pm-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pm-frac { font-family: var(--mono); font-size: 0.625rem; color: var(--ink-mute); }
  :global(.pathmap [data-chapter-key].p-done) .pm-frac { color: var(--pass); }
  .toc { margin-top: 1.5rem; }

  .codefig { margin: 1.25rem 0 0; }
  .codefig .top { border-top: none; border-bottom: 1px solid var(--panel-rule); }
  .codebody :global(pre) { margin: 0; padding: 0.875rem; overflow-x: auto; font-size: 0.8125rem; line-height: 1.65; background: transparent !important; }

  .labgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1rem; }
  .readings { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .readings li { display: flex; flex-direction: column; gap: 0.2rem; border: 1px solid var(--rule); background: var(--paper-high); padding: 0.75rem 1rem; }
  .readings a { font-family: var(--mono); font-size: 0.8125rem; color: var(--ink); text-decoration: none; }
  .readings a:hover { color: var(--accent-deep); text-decoration: underline; }
  .r-note { font-size: 0.8125rem; color: var(--ink-mute); }

  .pathpager { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 3.5rem; padding-top: 1.25rem; border-top: 1px solid var(--rule); }
  .pp-left { display: flex; flex-direction: column; gap: 0.375rem; }
  .pp-work { font-family: var(--mono); font-size: 0.6875rem; color: var(--ink-mute); }
  .pp-prev { font-family: var(--mono); font-size: 0.75rem; color: var(--ink-mute); text-decoration: none; }
  .pp-prev:hover { color: var(--accent-deep); }
  .pp-next { display: inline-flex; flex-direction: column; gap: 0.25rem; align-items: flex-end; text-align: right; text-decoration: none; border: 1px solid var(--accent-deep); background: var(--paper-high); padding: 0.625rem 0.875rem; border-radius: 2px; }
  .pp-next:hover { background: var(--paper); }
  .pp-k { font-family: var(--mono); font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-mute); }
  .pp-t { font-family: var(--mono); font-size: 0.8125rem; color: var(--accent-deep); }
</style>
