---
import Base from '../../layouts/Base.astro'

const FLOORS = [
  {
    href: '/gym/kernels',
    k: 'kernels floor',
    t: 'The full set of stations',
    d: 'The dot_general decoder, the shape oracle, spot the decision, the corpus and mosaic x-rays, fusion, the timeline, and the op reference.',
    m: '8 stations · serves kernel-path chapters 02 through 12',
  },
  {
    href: '/gym/jax',
    k: 'jax floor',
    t: 'Reading the recording',
    d: 'The shape oracle, name the transform, and the corpus x-ray: the fluency the jax path assigns in chapters 02 and 05.',
    m: '3 stations · streaks shared with every floor',
  },
  {
    href: '/gym/xla',
    k: 'xla floor',
    t: "The compiler's decisions",
    d: 'Spot the decision, the fusion x-ray from a real TPU compile, and a hardware profile read op by op.',
    m: '3 stations · serves xla-path chapters 04, 05, and 10',
  },
]
---

<Base
  title="The reading gym — Rudrite Kernels"
  description="One floor per mastery path: drills over generated corpora and captured dumps, streaks stored in your browser, the same skill counting on every floor that drills it."
>
  <div class="ws-ground">
    <section class="wband">
      <div class="wrap wgrid">
        <span class="wtag">the gym</span>
        <div>
          <p class="mono-label serves">one floor per path · every drill answer computed from generated dumps, never invented · streaks live in your browser only</p>
          <h1 class="wh1">Fluency is drills, not prose.</h1>
          <p class="wlede">
            Each path assigns stations from its own floor, and a streak is a streak wherever
            you earn it: the stores are shared, because the skill is. Pick the floor your
            path sent you to, or wander.
          </p>
          <div class="wings">
            {
              FLOORS.map((f) => (
                <a class="wing panel" href={f.href}>
                  <span class="mono-label wk">{f.k}</span>
                  <span class="wt">{f.t}</span>
                  <span class="wd">{f.d}</span>
                  <span class="wm">{f.m} →</span>
                </a>
              ))
            }
            <div class="wing panel reserved" aria-disabled="true">
              <span class="mono-label wk">pytorch floor</span>
              <span class="wt">Reserved</span>
              <span class="wd">Opens with the PyTorch mastery path.</span>
              <span class="wm">not yet open</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .serves { margin-bottom: 1rem; letter-spacing: 0.04em; }
  .wings { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin-top: 2rem; }
  @media (max-width: 900px) { .wings { grid-template-columns: 1fr; } }
  .wing { display: flex; flex-direction: column; gap: 0.45rem; padding: 1.125rem 1.25rem; text-decoration: none; }
  .wk { color: var(--copper); }
  .wt { font-family: var(--serif); font-weight: 600; font-size: 1.375rem; color: var(--panel-ink); }
  .wd { font-size: 0.875rem; color: var(--panel-mute); line-height: 1.6; }
  .wm { font-family: var(--mono); font-size: 0.75rem; color: var(--copper); margin-top: 0.375rem; }
  a.wing:hover .wt { color: var(--copper); }
  .wing.reserved { border-style: dashed; opacity: 0.75; }
  .wing.reserved .wm { color: var(--panel-mute); }
</style>
