---
import Base from '../../layouts/Base.astro'
import Exhibit from '../../components/Exhibit.astro'
import Rich from '../../components/Rich.astro'
import DotDecoder from '../../exhibits/DotDecoder'
import ShapeOracle from '../../exhibits/ShapeOracle'
import SpotDecision from '../../exhibits/SpotDecision'
import CorpusXray from '../../exhibits/CorpusXray'
import MosaicXray from '../../exhibits/MosaicXray'
import TransformDrill from '../../exhibits/TransformDrill'
import FusionXray from '../../exhibits/FusionXray'
import TimelineXray from '../../exhibits/TimelineXray'
import PlaceIt from '../../exhibits/PlaceIt'
import opCards from '../../data/op-cards.json'
import { PLACE_CELLS, PLACE_ITEMS } from '../../data/place-corpus'

const cards = Object.entries(opCards as Record<string, string>)

const OP_CATEGORY: Record<string, string> = {
  dot_general: 'compute', add: 'compute', sub: 'compute', mul: 'compute', div: 'compute',
  max: 'compute', exp: 'compute', log: 'compute', rsqrt: 'compute', erf: 'compute', tanh: 'compute',
  reduce_max: 'reduction', reduce_sum: 'reduction', reduce: 'reduction', argmax: 'reduction',
  transpose: 'shape', broadcast_in_dim: 'shape', reshape: 'shape', concatenate: 'shape',
  slice: 'shape', dynamic_slice: 'shape', iota: 'shape', convert_element_type: 'shape', one_hot: 'shape',
  select_n: 'control', scan: 'control', while: 'control', cond: 'control',
  custom_jvp_call: 'control', remat: 'control',
  psum: 'distributed', all_gather: 'distributed', ppermute: 'distributed',
}
const CATEGORIES = ['all', 'compute', 'reduction', 'shape', 'control', 'distributed']
---

<Base
  title="The reading gym · the kernels floor · Rudrite Kernels"
  description="Drills over a corpus of seventeen real programs: decode dimension_numbers on sight, predict shapes before the reveal, and read jaxpr and StableHLO until fluency."
>
  <div class="ws-ground">
    <section class="wband">
      <div class="wrap wgrid">
        <span class="wtag">the gym<br />kernels floor</span>
        <div>
          <p class="mono-label serves">serves kernel-path chapters 02 · 03 · 04 · 07 · 08 · 12 · the path assigns each drill with a streak target; the streaks check themselves off · <a class="wing-link" href="/gym">all floors</a></p>
          <h1 class="wh1">Fluency is drills, not prose.</h1>
          <p class="wlede">
            Seventeen real programs, traced and dumped: every jaxpr and StableHLO here was generated,
            never retyped, and every drill answer is computed from the same structured facts. Streaks
            persist in your browser and nowhere else. The bar, from chapter 12: read any dump on sight.
          </p>
        </div>
      </div>
    </section>

    <section class="wband" id="drills">
      <div class="wrap wgrid">
        <span class="wtag">drills<br />01-03</span>
        <div>
          <h2 class="wh2">Active recall, one tap</h2>
          <div class="drill-grid">
            <Exhibit designator="GYM·01" title="the dot_general decoder" provenance="instances extracted from the corpus jaxprs · 10 in a row is the fluency bar">
              <DotDecoder client:visible />
            </Exhibit>
            <Exhibit designator="GYM·02" title="the shape oracle" provenance="equations sampled from 278 real eqns · distractors computed, never invented">
              <ShapeOracle client:visible />
            </Exhibit>
          </div>
          <div class="drill-wide">
            <Exhibit designator="GYM·03" title="spot the decision" provenance="find the line the framework wrote for you: upcasts, hidden broadcasts, remat marks · targets computed by scanning the real dumps">
              <SpotDecision client:visible />
            </Exhibit>
          </div>
          <div class="drill-wide">
            <Exhibit designator="GYM·06" title="name the transform" provenance="one function traced under six transforms · dumps from gen_transform_gallery.py, loud primitive names redacted for the game">
              <TransformDrill client:visible />
            </Exhibit>
          </div>
        </div>
      </div>
    </section>

    <section class="wband" id="place">
      <div class="wrap wgrid">
        <span class="wtag">place<br />the artifact</span>
        <div>
          <h2 class="wh2">One dump, no label, back onto the map</h2>
          <p class="wlede narrow">
            Reading a dump you were handed is one skill. Recognizing which floor of the stack wrote it
            is another, and it is the one the map asks for. Every excerpt below came out of a real run:
            the specimen artifacts committed under bench/specimen, the generated corpora the chapters
            quote, and the TPU compile the fusion x-ray reads. Nothing was drawn to look like a dump.
            The vocabulary gives each one away once you have seen enough of them, and the cells you
            can point at are the map's own, distractors included.
          </p>
          <Exhibit
            designator="GYM·14"
            title="place the artifact"
            provenance={`${PLACE_ITEMS.length} excerpts from committed captures and generated corpora · one cell drawn first, then one artifact from it, so the corpus shape does not pick the questions · assigned in kernel chapters 02 and 03`}
          >
            <PlaceIt items={PLACE_ITEMS} cells={PLACE_CELLS} client:visible />
          </Exhibit>
        </div>
      </div>
    </section>

    <section class="wband" id="xray">
      <div class="wrap wgrid">
        <span class="wtag">the corpus<br />x-rayed</span>
        <div>
          <h2 class="wh2">Seventeen real programs, wired together</h2>
          <p class="wlede narrow">
            Pick a program and hover any column: the source line, the jaxpr it traced to, and the
            StableHLO it lowered to light up as one. Source attribution comes from jax's own records;
            the IR mapping is computed mechanically, and unmapped lines are conservative skips, never
            absences. Read a program at all three layers, narrate it, then move to one you have not seen.
          </p>
          <Exhibit designator="GYM·04" title="the corpus x-ray" provenance="17 programs, 236 sync groups, all derived by the mapping script · nothing hand-drawn">
            <CorpusXray client:visible />
          </Exhibit>
        </div>
      </div>
    </section>

    <section class="wband" id="fusion">
      <div class="wrap wgrid">
        <span class="wtag">before /<br />after</span>
        <div>
          <h2 class="wh2">The compiler's decisions, side by side</h2>
          <p class="wlede narrow">
            Chapter 04's two-dumps rule, made physical: the StableHLO XLA received on the left, the
            optimized HLO it decided on the right, captured on a real TPU. Fusion ops light up in
            copper, and the lines still carrying each program's big intermediate are underlined:
            in the attention program that is the spill, sitting in the compiler's own plan.
          </p>
          <Exhibit designator="GYM·07" title="the fusion x-ray" provenance="three programs captured by labs/capture-hlo.ipynb on v6e-1 · ops verbatim, frame tables trimmed, runtime paths scrubbed">
            <FusionXray client:visible />
          </Exhibit>
        </div>
      </div>
    </section>

    <section class="wband" id="timeline">
      <div class="wrap wgrid">
        <span class="wtag">the machine's<br />own account</span>
        <div>
          <h2 class="wh2">A real profile, read op by op</h2>
          <p class="wlede narrow">
            Twenty iterations of naive attention, traced on a v6e-1 and aggregated from the device
            plane: hardware time, not a cost model. Two things to find here. The envelope equals the
            two compute ops alone, so the 89.6 µs copy hid entirely behind compute. And the
            second-largest op is a kernel nobody in the program wrote: XLA:TPU pattern-matched the
            softmax and dispatched its own online-softmax custom call. Chapter 08's guide teaches
            the capture and the reading; LAB·2.3 has you reproduce all of it.
          </p>
          <Exhibit designator="GYM·08" title="the timeline x-ray" provenance="captured by labs/profile-bytes.ipynb on v6e-1, jax 0.11 · durations from the device plane, verbatim">
            <TimelineXray client:visible />
          </Exhibit>
        </div>
      </div>
    </section>

    <section class="wband" id="mosaic">
      <div class="wrap wgrid">
        <span class="wtag">one layer<br />down</span>
        <div>
          <h2 class="wh2">The layer below pallas_call</h2>
          <p class="wlede narrow">
            Pallas lowers your kernel to Mosaic, an MLIR dialect for TPU kernels, and that layer is
            still readable: the tpu dialect and much of its lowering live in the jax repo under
            jaxlib/mosaic, and any kernel prints its module with pallas_call(..., debug=True).
            Below Mosaic sits LLO, which is closed, so this is the last layer you can read.
            Reading it pays: the museum's lattice and VMEM errors speak this dialect's vocabulary.
            Find your BlockSpec index maps compiled into functions, and your pl.when compiled into
            a real branch.
          </p>
          <Exhibit designator="GYM·05" title="the mosaic x-ray" provenance="three track kernels captured from Pallas debug output · pairing computed by gen_mosaic_corpus.py, skips over guesses">
            <MosaicXray client:visible />
          </Exhibit>
        </div>
      </div>
    </section>

  </div>

  <section class="wband-light" id="ops">
    <div class="wrap wgrid">
      <span class="wtag">reference</span>
      <div>
        <h2 class="wh2">The op reference</h2>
        <p class="wlede narrow">Back on paper to read: every op the corpus uses, one card each. Filter by name or family; each card ends with the misread to avoid.</p>
        <div class="op-controls">
          <input type="search" class="op-filter" placeholder="filter ops: dot, reduce, convert…" aria-label="Filter ops" />
          <div class="op-cats" role="group" aria-label="Filter by family">
            {CATEGORIES.map((c) => (
              <button type="button" class={`op-cat ${c === 'all' ? 'on' : ''}`} data-cat={c}>{c}</button>
            ))}
          </div>
          <span class="mono-label op-count"><span data-op-count>{cards.length}</span> of {cards.length} ops</span>
        </div>
        <dl class="cards">
          {
            cards.map(([op, text]) => (
              <div class="card" data-op={op} data-category={OP_CATEGORY[op] ?? 'compute'}>
                <dt>
                  <code class="ri">{op}</code>
                  <span class="cat-tag">{OP_CATEGORY[op] ?? 'compute'}</span>
                </dt>
                <dd><Rich text={text} /></dd>
              </div>
            ))
          }
        </dl>
        <p class="mono-label no-match" hidden>no ops match</p>
      </div>
    </div>
  </section>

  <script>
    const input = document.querySelector<HTMLInputElement>('.op-filter')
    const entries = Array.from(document.querySelectorAll<HTMLElement>('.card[data-op]'))
    const empty = document.querySelector<HTMLElement>('.no-match')
    const count = document.querySelector<HTMLElement>('[data-op-count]')
    const cats = Array.from(document.querySelectorAll<HTMLButtonElement>('.op-cat'))
    let activeCat = 'all'
    const apply = () => {
      const q = (input?.value ?? '').trim().toLowerCase()
      let shown = 0
      for (const el of entries) {
        const catOk = activeCat === 'all' || el.getAttribute('data-category') === activeCat
        const textOk = !q || (el.getAttribute('data-op') ?? '').toLowerCase().includes(q) || (el.textContent ?? '').toLowerCase().includes(q)
        const hit = catOk && textOk
        el.hidden = !hit
        if (hit) shown++
      }
      if (empty) empty.hidden = shown > 0
      if (count) count.textContent = String(shown)
    }
    input?.addEventListener('input', apply)
    for (const b of cats) {
      b.addEventListener('click', () => {
        activeCat = b.getAttribute('data-cat') ?? 'all'
        for (const o of cats) o.classList.toggle('on', o === b)
        apply()
      })
    }
  </script>
</Base>

<style>
  .serves { margin-bottom: 1rem; letter-spacing: 0.04em; }
  .wing-link { color: var(--accent-ink); text-decoration: none; }
  .wing-link:hover { text-decoration: underline; }
  .wh1 + .wlede { margin-top: 1rem; }
  .wlede.narrow { margin-bottom: 1.25rem; }
  h2.wh2 { margin-bottom: 1rem; }

  .drill-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; align-items: start; }
  @media (max-width: 1000px) { .drill-grid { grid-template-columns: minmax(0, 1fr); } }
  .drill-wide { margin-top: 1.25rem; }

  

  .op-controls { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; margin-bottom: 1.25rem; }
  .op-cats { display: flex; gap: 0.375rem; flex-wrap: wrap; }
  .op-cat { font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.05em; background: var(--plate); border: 1px solid var(--edge); border-radius: 3px; padding: 0.3rem 0.7rem; color: var(--ink-mute); cursor: pointer; }
  .op-cat:hover { border-color: var(--accent); color: var(--accent-ink); }
  .op-cat.on { border-color: var(--accent); color: var(--accent-ink); text-shadow: var(--bloom); background: var(--accent-wash); }
  .op-count { white-space: nowrap; }
  .cat-tag { font-family: var(--mono); font-size: 0.625rem; letter-spacing: 0.08em; color: var(--ink-mute); margin-left: 0.6rem; text-transform: uppercase; }
  .op-filter {
    font-family: var(--mono); font-size: 0.8125rem; color: var(--ink);
    background: var(--plate); border: 1px solid var(--edge); border-radius: 3px;
    padding: 0.5rem 0.75rem; width: min(100%, 20rem);
  }
  .cards { columns: 2; column-gap: 2.5rem; margin: 0; }
  @media (max-width: 900px) { .cards { columns: 1; } }
  .card { break-inside: avoid; padding-block: 0.625rem; border-bottom: 1px solid var(--edge-soft); }
  .card dt { margin-bottom: 0.25rem; }
  .card dd { margin: 0; font-size: 0.9375rem; line-height: 1.6; color: var(--ink); font-family: var(--serif); }
  .no-match { margin-top: 1rem; }
</style>
