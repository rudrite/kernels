---
import { Code } from 'astro:components'
import Base from '../../layouts/Base.astro'
import Rich from '../../components/Rich.astro'
import SectionHead from '../../components/SectionHead.astro'
import ReadingRails from '../../components/ReadingRails.astro'
import MasteryWork from '../../components/MasteryWork.astro'
import SpecimenSlice from '../../components/SpecimenSlice.astro'
import MiniMap from '../../components/MiniMap.astro'
import BlockDiagram from '../../components/BlockDiagram.astro'
import LabCard from '../../components/LabCard.astro'
import LessonList from '../../components/LessonList.astro'
import { lessonsOf } from '../../data/lessons'
import Exhibit from '../../components/Exhibit.astro'
import StrideExplorer from '../../exhibits/StrideExplorer'
import TapeWalker from '../../exhibits/TapeWalker'
import { PT_CHAPTERS, PT_PATH, ptChapterAt, type PtChapter } from '../../data/pytorch/track'
import { PT_DIAGRAMS } from '../../data/pytorch/diagrams'
import type { Lab } from '../../data/track'

const INSTRUMENTS: Record<string, { d: string; t: string; p: string }> = {
  autograd: {
    d: 'EX·18',
    t: 'the tape, walked',
    p: 'four expressions run on torch 2.2.2, their grad_fn chains followed through next_functions · step backward the way backward does',
  },
  tensors: {
    d: 'EX·14',
    t: 'the view explorer',
    p: 'build a chain of views and watch the map change while the storage does not · the arithmetic is checked against 48 chains run on torch 2.2.2',
  },
}

const COLAB = 'https://colab.research.google.com/github/rudrite/kernels/blob/main/'
const lab = (designator: string, title: string, time: string, hardware: string, file: string): Lab => ({
  designator, title, time, hardware, colab: COLAB + file, notebook: file,
})
// One runnable lab per chapter that has one; the mastery ledger's labs
// auto-rule checks off when the card's mark-as-run is ticked.
const LABS: Record<string, Lab[]> = {
  tensors: [lab('LAB·P1', 'Storage and strides, by hand', '~1 h', 'any machine', 'labs/pytorch/lab-p1-storage-and-strides.ipynb')],
  autograd: [lab('LAB·P2', 'The tape under a microscope', '~1.5 h', 'any machine', 'labs/pytorch/lab-p2-tape-microscope.ipynb')],
  dynamo: [lab('LAB·P3', 'Guards, breaks, counters', '~1.5 h', 'any machine', 'labs/pytorch/lab-p3-guards-breaks-counters.ipynb')],
  bridges: [
    lab('LAB·P4', 'Torch on a TPU', '~2 h', 'Colab TPU', 'labs/pytorch/lab-p4-torch-on-tpu.ipynb'),
    lab('LAB·P5', 'The boundary trace', '~2 h', 'Colab TPU', 'labs/pytorch/lab-p5-boundary-trace.ipynb'),
  ],
}

export function getStaticPaths() {
  return PT_CHAPTERS.map((chapter) => ({ params: { id: chapter.id }, props: { chapter } }))
}

interface Props {
  chapter: PtChapter
}
const { chapter } = Astro.props
const key = `pt:${chapter.id}`
const { prev, next } = ptChapterAt(key)
const pad = (n: number) => String(n).padStart(2, '0')
const slug = (h: string) => h.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
const partLabel = chapter.part === 'i' ? 'part i, the model' : 'part ii, the practice'
// Presentation-owned diagram slots for chapters whose data carries none.
const EXTRA_DIAGRAMS: Record<string, { id: string; after: number }> = {
  'the-loop': { id: 'pt-loop', after: 0 },
  modules: { id: 'pt-modules', after: 0 },
  data: { id: 'pt-data', after: 0 },
  graphs: { id: 'pt-graphs', after: 0 },
  performance: { id: 'pt-timing', after: 0 },
  'tpu-practice': { id: 'pt-tpu-practice', after: 0 },
  'training-run': { id: 'pt-run', after: 0 },
  distributed: { id: 'pt-ddp-fsdp', after: 1 },
}
const slot = chapter.diagram ?? EXTRA_DIAGRAMS[chapter.id]
const diagram = slot ? PT_DIAGRAMS[slot.id] : undefined
---

<Base
  title={`${chapter.title} · the PyTorch path · Rudrite Kernels`}
  description={chapter.lede}
>
  <section class="chapter-head">
    <div class="wrap">
      <p class="mono-label kicker">the pytorch path · chapter {pad(chapter.num)} of {PT_PATH.length} · {partLabel}</p>
      <h1>{chapter.title}</h1>
      <p class="lede"><Rich text={chapter.lede} self={`/pytorch/${chapter.id}`} /></p>
      <p class="goal"><span class="mono-label">the goal</span> <Rich text={chapter.goal} self={`/pytorch/${chapter.id}`} /></p>
    </div>
  </section>

  <div class="wrap layout">
    <aside class="side">
      <MiniMap unit={key} />
      <nav class="pathmap" aria-label="The PyTorch path">
        <span class="mono-label toc-head">the pytorch path</span>
        <ol>
          {
            PT_PATH.map((c) => (
              <li class={`${c.num === 8 ? 'part-break' : ''} ${c.key === key ? 'here' : ''}`}>
                <a href={c.href} data-chapter-key={c.key}>
                  <span class="pm-num">{pad(c.num)}</span>
                  <span class="pm-title">{c.title}</span>
                  <span class="pm-frac meas" data-work-frac={c.key} />
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <nav class="toc" aria-label="On this page">
        <span class="mono-label toc-head">on this page</span>
        <ol>
          {chapter.sections.map((sec) => <li><a href={`#${slug(sec.h)}`}>{sec.h}</a></li>)}
        </ol>
      </nav>
    </aside>

    <article class="main">
      <MasteryWork chapterKey={key} />
      <SpecimenSlice unit={key} />

      {
        chapter.sections.map((sec, si) => (
          <section class="block prose">
            <SectionHead id={slug(sec.h)} eyebrow={`§ ${pad(si + 1)}`} title={sec.h.charAt(0).toUpperCase() + sec.h.slice(1)} />
            {sec.ps.map((p) =>
              p.startsWith('>> ') ? (
                <blockquote class="pull">{p.slice(3)}</blockquote>
              ) : (
                <p class="theory">
                  <Rich text={p} self={`/pytorch/${chapter.id}`} />
                </p>
              ),
            )}
            {sec.code && (
              <figure class="panel codefig">
                <figcaption class="provenance top">{sec.code.caption}</figcaption>
                <div class="codebody">
                  <Code code={sec.code.text} lang={sec.code.lang === 'text' ? 'txt' : 'python'} theme="vesper" />
                </div>
              </figure>
            )}
            {diagram && slot!.after === si && (
              <figure class="panel codefig">
                <figcaption class="provenance top">{diagram.caption}</figcaption>
                <BlockDiagram spec={diagram} />
              </figure>
            )}
          </section>
        ))
      }

      <section class="block">
        <SectionHead id="readings" eyebrow="assigned" title="Readings" />
        <ul class="readings">
          {
            chapter.readings.map((r) => (
              <li class="plate">
                <a href={r.url} target="_blank" rel="noopener">{r.label} ↗</a>
                <span class="r-note">{r.note}</span>
              </li>
            ))
          }
        </ul>
      </section>

      {
        lessonsOf(key).length > 0 && (
          <section class="block">
            <SectionHead id="lessons" eyebrow="go deeper, in order" title="Lessons" />
            <LessonList unit={key} />
          </section>
        )
      }

      {
        LABS[chapter.id] && (
          <section class="block" id="labs">
            <SectionHead id="labs-head" eyebrow="runnable" title="Labs" />
            <div class="labgrid">
              {LABS[chapter.id]!.map((l) => (
                <LabCard lab={l} />
              ))}
            </div>
          </section>
        )
      }


      {
        INSTRUMENTS[chapter.id] && (
          <section class="block" id="instruments">
            <SectionHead id="instruments-head" eyebrow="live" title="Instrument" />
            <Exhibit designator={INSTRUMENTS[chapter.id]!.d} title={INSTRUMENTS[chapter.id]!.t} provenance={INSTRUMENTS[chapter.id]!.p}>
              {chapter.id === 'autograd' ? <TapeWalker client:visible /> : <StrideExplorer client:visible />}
            </Exhibit>
          </section>
        )
      }

      <nav class="pathpager" aria-label="The PyTorch path">
        <div class="pp-left">
          {prev ? <a class="pp-prev" href={prev.href}>← ch {pad(prev.num)} · {prev.title}</a> : <a class="pp-prev" href="/pytorch">← the pytorch path</a>}
          <span class="pp-work">this chapter's work · <span data-work-frac={key}>·</span></span>
        </div>
        {
          next ? (
            <a class="pp-next" href={next.href}>
              <span class="pp-k">next on the path</span>
              <span class="pp-t">ch {pad(next.num)} · {next.title} →</span>
            </a>
          ) : (
            <a class="pp-next" href="/xla">
              <span class="pp-k">the pytorch path ends here</span>
              <span class="pp-t">the xla path owns the floor below →</span>
            </a>
          )
        }
      </nav>
    </article>

    <aside class="right">
      <div class="rail">
        <div>
          <span class="rail-head">reading progress</span>
          <span class="progress-num meas">0%</span>
          <div class="progress-bar"><i></i></div>
        </div>
        <div>
          <span class="rail-head">this chapter</span>
          <div class="card">
            <div class="row"><span class="k">chapter</span><span>{pad(chapter.num)} of {PT_PATH.length}</span></div>
            <div class="row"><span class="k">part</span><span>{partLabel}</span></div>
            <div class="row"><span class="k">readings</span><span>{chapter.readings.length} assigned</span></div>
          </div>
        </div>
        <div>
          <span class="rail-head">part of</span>
          <ul>
            <li><a href="/pytorch">the pytorch path · twelve chapters</a></li>
            <li><a href="/xla">the xla path · under the bridges</a></li>
            <li><a href="/">the kernel path · the floor below</a></li>
          </ul>
        </div>
      </div>
    </aside>
  </div>
  <ReadingRails />
</Base>

<style>
  .layout { display: grid; grid-template-columns: 13.5rem minmax(0, 1fr) 13rem; gap: 3rem; padding-block: 2.5rem; }
  .side, .right { position: sticky; top: 2rem; align-self: start; }
  @media (max-width: 1240px) { .layout { grid-template-columns: 13.5rem minmax(0, 1fr); } .right { display: none; } }
  @media (max-width: 960px) { .layout { grid-template-columns: minmax(0, 1fr); } .side { display: none; } }

  .chapter-head {
    padding-block: 2rem 2.25rem; background: var(--plate); border-bottom: 2px solid var(--edge);
    background-image: repeating-linear-gradient(to bottom, var(--scan) 0 1px, transparent 1px 3px);
  }
  .chapter-head .kicker { margin-bottom: 0.875rem; }
  .chapter-head .lede { margin-top: 0.9rem; color: var(--ink-mute); max-width: 62ch; }
  .chapter-head .goal { margin-top: 1.1rem; font-size: 0.9375rem; color: var(--ink); max-width: 70ch; border-left: 3px solid var(--accent); padding-left: 0.9rem; }
  .chapter-head .goal .mono-label { color: var(--accent); text-shadow: var(--bloom); margin-right: 0.4rem; }

  .block { margin-top: 2.5rem; }
  .theory { margin-bottom: 1em; }

  .pathmap ol { list-style: none; margin: 0.5rem 0 0; padding: 0; }
  .pathmap li.part-break { margin-top: 0.625rem; padding-top: 0.625rem; border-top: 1px solid var(--edge-soft); }
  .pathmap a { display: flex; align-items: baseline; gap: 0.5rem; padding: 0.22rem 0; text-decoration: none; color: var(--ink-mute); font-size: 0.8125rem; }
  .pathmap a:hover { color: var(--accent); }
  .pathmap li.here a { color: var(--accent); text-shadow: var(--bloom); }
  .pm-num { font-family: var(--mono); font-size: 0.6875rem; color: var(--accent-deep); }
  .pm-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pm-frac { font-family: var(--mono); font-size: 0.625rem; color: var(--ink-mute); }
  :global(.pathmap [data-chapter-key].p-done) .pm-frac { color: var(--pass); }
  .toc { margin-top: 1.5rem; }

  .codefig { margin: 1.25rem 0 0; }
  .codefig .top { border-top: none; border-bottom: 1px solid var(--panel-rule); }
  .codebody :global(pre) { margin: 0; padding: 0.875rem; overflow-x: auto; font-size: 0.8125rem; line-height: 1.65; background: transparent !important; }

  .labgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1rem; }
  .readings { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .readings li { display: flex; flex-direction: column; gap: 0.2rem; padding: 0.75rem 0.95rem; }
  .readings a { font-family: var(--mono); font-size: 0.8125rem; color: var(--ink); text-decoration: none; }
  .readings a:hover { color: var(--accent); }
  .r-note { font-size: 0.8125rem; color: var(--ink-mute); }

  .pathpager { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 3rem; padding-top: 1.1rem; border-top: 2px solid var(--edge); }
  .pp-left { display: flex; flex-direction: column; gap: 0.375rem; }
  .pp-work { font-family: var(--mono); font-size: 0.6875rem; color: var(--ink-faint); }
  .pp-prev { font-family: var(--mono); font-size: 0.75rem; color: var(--ink-faint); text-decoration: none; }
  .pp-prev:hover { color: var(--accent); }
  .pp-next {
    display: inline-flex; flex-direction: column; gap: 0.2rem; align-items: flex-end; text-align: right;
    text-decoration: none; border: 2px solid var(--accent); border-radius: 3px;
    background: var(--accent-wash); padding: 0.6rem 0.9rem; box-shadow: var(--stamp-sm);
    transition: transform 110ms steps(2, jump-none);
  }
  .pp-next:hover { transform: translate(-2px, -2px); }
  .pp-k { font-family: var(--mono); font-size: 0.625rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-faint); }
  .pp-t { font-family: var(--mono); font-size: 0.8125rem; color: var(--accent); text-shadow: var(--bloom); }
</style>
