---
import Base from '../../layouts/Base.astro'
import BlockDiagram from '../../components/BlockDiagram.astro'
import { PT_CHAPTERS, PT_PATH } from '../../data/pytorch/track'
import { PT_DIAGRAMS } from '../../data/pytorch/diagrams'

const pad = (n: number) => String(n).padStart(2, '0')
const partI = PT_CHAPTERS.filter((c) => c.part === 'i')
const partII = PT_CHAPTERS.filter((c) => c.part === 'ii')
const bridges = PT_DIAGRAMS['pt-bridges']!

const OUTCOMES = [
  { n: '01', h: 'Predict the tape', p: 'strides, views, grad_fn, and every museum error' },
  { n: '02', h: 'Read compile like a contract', p: 'guards, breaks, graphs, counted not guessed' },
  { n: '03', h: 'Land torch on TPU', p: 'torchax and torch_xla, into the stack this site teaches' },
]
---

<Base
  title="Rudrite Kernels · the PyTorch path · learn to think in PyTorch, land on TPU"
  description="A mastery course through PyTorch: tensors to torch.compile to the TPU bridges, every snippet run before it was printed, a strict superset of the official tutorial series."
>
  <section class="wrap hero">
    <div class="hero-copy">
      <p class="mono-label kicker">a mastery course · the pytorch path · the eager world, landing on tpu</p>
      <h1>Learn to think in PyTorch.</h1>
      <p class="lede">
        PyTorch is the other philosophy: state is the model, the tape is dynamic, and compilation
        is opt-in. Part i builds that model until the museum's errors are predictable. Part ii is
        the practice, and it ends where this site lives: torch running on TPU, over bridges that
        lower into the same compiler the XLA path opens.
      </p>
      <div class="cta-row">
        <a class="cta primary" href={PT_PATH[0]!.href} data-continue="pytorch"><span data-continue-label>start the path → chapter 1</span></a>
        <a class="cta" href="/jax">the jax path</a>
        <a class="cta" href="/xla">the xla path</a>
      </div>
      <p class="stat-line">
        your progress <span class="meas" data-path-progress="pytorch">0/{PT_PATH.length}</span> chapters
      </p>
      <div class="your-bar" aria-hidden="true"><i data-path-progress-bar="pytorch"></i></div>
      <div class="outcome-strip">
        {OUTCOMES.map((o) => (
          <div><span class="meas onum">{o.n}</span> <strong>{o.h}</strong><span class="op"> · {o.p}</span></div>
        ))}
      </div>
    </div>
    <div class="hero-instrument">
      <figure class="panel machinefig">
        <figcaption class="provenance top">{bridges.caption}</figcaption>
        <BlockDiagram spec={bridges} />
      </figure>
    </div>
  </section>

  <section class="wrap ledger">
    <div class="part">
      <header class="part-head">
        <span class="mono-label">part i · the model</span>
        <p>How PyTorch thinks: storage and strides, the dynamic tape, stateful modules, the loop you own, and the compilers that recover a graph from all of it.</p>
      </header>
      <ol class="rows" start={1}>
        {
          partI.map((c) => (
            <li>
              <a href={`/pytorch/${c.id}`} data-chapter-key={`pt:${c.id}`}>
                <span class="row-num">ch {pad(c.num)}</span>
                <span class="row-body">
                  <span class="row-title">{c.title}</span>
                  <span class="row-lede">{c.lede}</span>
                </span>
                <span class="row-frac meas" data-work-frac={`pt:${c.id}`} />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="part">
      <header class="part-head">
        <span class="mono-label">part ii · the practice</span>
        <p>Ranks and meshes, honest measurement, then the destination: the two bridges to TPU and a capstone run across one of them.</p>
      </header>
      <ol class="rows" start={8}>
        {
          partII.map((c) => (
            <li>
              <a href={`/pytorch/${c.id}`} data-chapter-key={`pt:${c.id}`}>
                <span class="row-num">ch {pad(c.num)}</span>
                <span class="row-body">
                  <span class="row-title">{c.title}</span>
                  <span class="row-lede">{c.lede}</span>
                </span>
                <span class="row-frac meas" data-work-frac={`pt:${c.id}`} />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="promises">
    <div class="wrap promise-grid">
      <div class="p-item">
        <span class="mono-label p-head">the superset rule</span>
        <p>
          Every page of the official Learn-the-Basics series and the intermediate tutorials this
          path covers is assigned reading somewhere, and the chapters keep going: the stride map,
          the guard set, the two-bridge ledger, the benchmarking method.
        </p>
      </div>
      <div class="p-item">
        <span class="mono-label p-head">the honesty rule</span>
        <p>
          Every snippet in part i ran before it was printed (torch 2.2.2 on CPU, this machine,
          2026-07-27), and printed values are real outputs. The TPU chapters say plainly that
          their hardware claims await the Colab lab pass; nothing pretends otherwise.
        </p>
      </div>
      <div class="p-item">
        <span class="mono-label p-head">the neighbors</span>
        <p>
          The bridges land on StableHLO, where the <a href="/xla">XLA path</a> picks up; the
          <a href="/jax">JAX path</a> is the philosophy this one contrasts against, named in
          every chapter that differs; the <a href="/gym/pytorch">pytorch gym floor</a> drills
          the stride map with real torch outputs.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 3rem; align-items: center; padding-block: clamp(2.5rem, 6vw, 4rem) 2rem; }
  @media (max-width: 1100px) { .hero { grid-template-columns: minmax(0, 1fr); } }
  .kicker { display: block; margin-bottom: 1.1rem; color: var(--accent-ink); text-shadow: var(--bloom); }
  h1 {
    font-family: var(--grot); font-weight: 800;
    font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1.02; letter-spacing: -0.03em;
  }
  .lede { margin-top: 1.25rem; font-size: 1.125rem; max-width: 48ch; color: var(--ink-mute); }
  .cta-row { display: flex; gap: 0.75rem; margin-top: 1.75rem; flex-wrap: wrap; }
  .cta {
    font-family: var(--mono); font-size: 0.8125rem; letter-spacing: 0.04em; text-decoration: none;
    border: 2px solid var(--edge-hi); border-radius: 3px; padding: 0.7rem 1.05rem;
    background: var(--plate); color: var(--ink); box-shadow: var(--stamp);
    transition: transform 110ms steps(2, jump-none);
  }
  .cta:hover { transform: translate(-2px, -2px); }
  .cta.primary { border-color: var(--accent); color: var(--accent-ink); text-shadow: var(--bloom); background: var(--accent-wash); }
  .stat-line { margin-top: 1.5rem; font-family: var(--mono); font-size: 0.8125rem; color: var(--ink-mute); }
  .your-bar { height: 3px; background: var(--plate-2); border: 1px solid var(--edge); margin-top: 0.5rem; max-width: 24rem; }
  .your-bar i { display: block; height: 100%; width: 0; background: var(--pass); }
  .outcome-strip { margin-top: 1.5rem; display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.875rem; }
  .outcome-strip .onum { color: var(--accent-ink); font-size: 0.75rem; }
  .outcome-strip .op { color: var(--ink-mute); }
  .machinefig { margin: 0; }
  .machinefig .top { border-top: none; border-bottom: 1px solid var(--panel-rule); }

  .ledger { display: grid; grid-template-columns: 1fr; gap: 2.5rem; padding-block: 1.5rem 2.5rem; }
  .part-head { display: flex; align-items: baseline; gap: 1.25rem; border-top: 2px solid var(--edge); padding-top: 1rem; margin-bottom: 0.75rem; flex-wrap: wrap; }
  .part-head .mono-label { color: var(--accent-ink); text-shadow: var(--bloom); }
  .part-head p { color: var(--ink-mute); font-size: 0.9375rem; max-width: 62ch; }
  .rows { list-style: none; margin: 0; padding: 0; }
  .rows a { display: flex; align-items: baseline; gap: 1.25rem; padding: 0.875rem 0.5rem; border-bottom: 1px solid var(--edge-soft); text-decoration: none; color: inherit; }
  .rows a:hover { background: var(--plate); }
  .rows a:hover .row-title { color: var(--accent-ink); }
  .row-num { font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-deep); flex: 0 0 3.5rem; }
  .row-body { display: flex; flex-direction: column; gap: 0.2rem; flex: 1; min-width: 0; }
  .row-title { font-family: var(--grot); font-weight: 700; font-size: 1.1875rem; letter-spacing: -0.015em; }
  .row-lede { font-size: 0.875rem; color: var(--ink-mute); max-width: 72ch; }
  .row-frac { font-family: var(--mono); font-size: 0.75rem; color: var(--ink-mute); white-space: nowrap; }
  :global(.rows a.p-done) .row-frac { color: var(--pass); }

  .promises { background: var(--plate-2); border-top: 2px solid var(--edge); padding-block: 2.5rem 3rem; }
  .promise-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; }
  @media (max-width: 960px) { .promise-grid { grid-template-columns: minmax(0, 1fr); } }
  .p-head { display: block; margin-bottom: 0.625rem; color: var(--accent-ink); text-shadow: var(--bloom); }
  .p-item p { font-family: var(--serif); font-size: 0.9875rem; line-height: 1.65; color: var(--ink); }
  .p-item a { color: var(--accent-deep); }
</style>
