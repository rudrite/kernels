---
import Base from '../../layouts/Base.astro'
import BlockDiagram from '../../components/BlockDiagram.astro'
import { JAX_CHAPTERS, JAX_PATH } from '../../data/jax/track'
import { JAX_DIAGRAMS } from '../../data/jax/diagrams'

const pad = (n: number) => String(n).padStart(2, '0')
const partI = JAX_CHAPTERS.filter((c) => c.part === 'i')
const partII = JAX_CHAPTERS.filter((c) => c.part === 'ii')
const machine = JAX_DIAGRAMS['jax-machine']!

const OUTCOMES = [
  { n: '01', h: 'Read any jaxpr on sight', p: 'what the trace kept, what Python lost' },
  { n: '02', h: 'Predict every recompile', p: 'the cache key as arithmetic, not weather' },
  { n: '03', h: 'Scale one program to a mesh', p: 'sharding as three levels of control' },
]
---

<Base
  title="Rudrite Kernels — the JAX path — learn to think in JAX"
  description="A mastery course across JAX: twelve chapters from arrays to a sharded training run, every code snippet run before it was printed, a strict superset of the official tutorials."
>
  <section class="wrap hero">
    <div class="hero-copy">
      <p class="mono-label kicker">a mastery course · the jax path · across the language</p>
      <h1>Learn to think in JAX.</h1>
      <p class="lede">
        JAX is one idea worn twelve ways: your function becomes data, and everything else
        (grad, vmap, jit, sharding) is a transformation of the recording. Part i builds that model
        until surprises stop. Part ii runs it at production scale.
      </p>
      <div class="cta-row">
        <a class="cta primary" href={JAX_PATH[0]!.href} data-continue="jax"><span data-continue-label>start the path → chapter 1</span></a>
        <a class="cta" href="/">the kernel path</a>
      </div>
      <p class="stat-line">
        your progress <span class="meas" data-path-progress="jax">0/{JAX_PATH.length}</span> chapters
      </p>
      <div class="your-bar" aria-hidden="true"><i data-path-progress-bar="jax"></i></div>
      <div class="outcome-strip">
        {OUTCOMES.map((o) => (
          <div><span class="meas onum">{o.n}</span> <strong>{o.h}</strong><span class="op"> · {o.p}</span></div>
        ))}
      </div>
    </div>
    <div class="hero-instrument">
      <figure class="panel machinefig">
        <figcaption class="provenance top">{machine.caption}</figcaption>
        <BlockDiagram spec={machine} />
      </figure>
    </div>
  </section>

  <section class="wrap ledger">
    <div class="part">
      <header class="part-head">
        <span class="mono-label">part i · the model</span>
        <p>How JAX thinks. Eight chapters that make the machine's behavior derivable instead of memorized.</p>
      </header>
      <ol class="rows" start={1}>
        {
          partI.map((c) => (
            <li>
              <a href={`/jax/${c.id}`} data-chapter-key={`jax:${c.id}`}>
                <span class="row-num">ch {pad(c.num)}</span>
                <span class="row-body">
                  <span class="row-title">{c.title}</span>
                  <span class="row-lede">{c.lede}</span>
                </span>
                <span class="row-frac meas" data-work-frac={`jax:${c.id}`} />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="part">
      <header class="part-head">
        <span class="mono-label">part ii · the practice</span>
        <p>State, the mesh, honest measurement, and the training run that composes all of it.</p>
      </header>
      <ol class="rows" start={9}>
        {
          partII.map((c) => (
            <li>
              <a href={`/jax/${c.id}`} data-chapter-key={`jax:${c.id}`}>
                <span class="row-num">ch {pad(c.num)}</span>
                <span class="row-body">
                  <span class="row-title">{c.title}</span>
                  <span class="row-lede">{c.lede}</span>
                </span>
                <span class="row-frac meas" data-work-frac={`jax:${c.id}`} />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="promises">
    <div class="wrap promise-grid">
      <div class="p-item">
        <span class="mono-label p-head">the superset rule</span>
        <p>
          Every page of the official JAX tutorial series is assigned reading somewhere on this
          path, and the chapters keep going where the docs stop: the cache key, the cost model of
          reverse mode, the sharding ladder, the benchmarking method.
        </p>
      </div>
      <div class="p-item">
        <span class="mono-label p-head">the honesty rule</span>
        <p>
          Every snippet ran before it was printed (jax 0.4.38 on CPU, this machine, 2026-07-27;
          eight host devices for the sharding chapter), and printed outputs are real outputs.
          Where the current API differs from the verified one, the caption says so.
        </p>
      </div>
      <div class="p-item">
        <span class="mono-label p-head">the layer below</span>
        <p>
          When a chapter names XLA, fusion, or the interconnect, the kernel path teaches that
          layer with its own hands: <a href="/">fifteen chapters down the stack</a>, gates
          measured on real TPUs. The two paths cross-reference; neither repeats the other.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 3rem; align-items: center; padding-block: clamp(2.5rem, 6vw, 4rem) 2rem; }
  @media (max-width: 1100px) { .hero { grid-template-columns: minmax(0, 1fr); } }
  .kicker { display: block; margin-bottom: 1.25rem; color: var(--copper-deep); }
  h1 { font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1.05; font-weight: 600; letter-spacing: -0.01em; }
  .lede { margin-top: 1.25rem; font-size: 1.125rem; max-width: 48ch; }
  .cta-row { display: flex; gap: 1rem; margin-top: 1.75rem; flex-wrap: wrap; }
  .cta { font-family: var(--mono); font-size: 0.8125rem; text-decoration: none; border: 1px solid var(--ink-mute); padding: 0.625rem 1rem; border-radius: 2px; color: var(--ink); background: var(--paper-high); }
  .cta:hover { border-color: var(--copper-deep); color: var(--copper-deep); }
  .cta.primary { border-color: var(--copper-deep); color: var(--copper-deep); }
  .stat-line { margin-top: 1.5rem; font-family: var(--mono); font-size: 0.8125rem; color: var(--ink-mute); }
  .your-bar { height: 2px; background: var(--rule-soft); margin-top: 0.5rem; max-width: 24rem; }
  .your-bar i { display: block; height: 100%; width: 0; background: var(--pass); }
  .outcome-strip { margin-top: 1.5rem; display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.875rem; }
  .outcome-strip .onum { color: var(--copper-deep); font-size: 0.75rem; }
  .outcome-strip .op { color: var(--ink-mute); }
  .machinefig { margin: 0; }
  .machinefig .top { border-top: none; border-bottom: 1px solid var(--panel-rule); }

  .ledger { display: grid; grid-template-columns: 1fr; gap: 2.5rem; padding-block: 1.5rem 2.5rem; }
  .part-head { display: flex; align-items: baseline; gap: 1.25rem; border-top: 1px solid var(--rule); padding-top: 1rem; margin-bottom: 0.75rem; flex-wrap: wrap; }
  .part-head .mono-label { color: var(--copper-deep); }
  .part-head p { color: var(--ink-mute); font-size: 0.9375rem; max-width: 60ch; }
  .rows { list-style: none; margin: 0; padding: 0; }
  .rows a { display: flex; align-items: baseline; gap: 1.25rem; padding: 0.875rem 0.5rem; border-bottom: 1px solid var(--rule-soft); text-decoration: none; color: inherit; }
  .rows a:hover { background: var(--paper-high); }
  .rows a:hover .row-title { color: var(--copper-deep); }
  .row-num { font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--copper-deep); flex: 0 0 3.5rem; }
  .row-body { display: flex; flex-direction: column; gap: 0.2rem; flex: 1; min-width: 0; }
  .row-title { font-family: var(--serif); font-weight: 600; font-size: 1.1875rem; }
  .row-lede { font-size: 0.875rem; color: var(--ink-mute); max-width: 72ch; }
  .row-frac { font-family: var(--mono); font-size: 0.75rem; color: var(--ink-mute); white-space: nowrap; }
  :global(.rows a.p-done) .row-frac { color: var(--pass); }

  .promises { background: var(--paper-high); border-top: 1px solid var(--rule); padding-block: 2.5rem 3rem; }
  .promise-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; }
  @media (max-width: 960px) { .promise-grid { grid-template-columns: minmax(0, 1fr); } }
  .p-head { display: block; margin-bottom: 0.625rem; color: var(--copper-deep); }
  .p-item p { font-family: var(--serif); font-size: 0.9875rem; line-height: 1.65; color: var(--ink); }
  .p-item a { color: var(--copper-deep); }
</style>
