---
import { Code } from 'astro:components'
import Base from '../../layouts/Base.astro'
import Rich from '../../components/Rich.astro'
import SectionHead from '../../components/SectionHead.astro'
import ReadingRails from '../../components/ReadingRails.astro'
import MasteryWork from '../../components/MasteryWork.astro'
import BlockDiagram from '../../components/BlockDiagram.astro'
import LabCard from '../../components/LabCard.astro'
import Exhibit from '../../components/Exhibit.astro'
import CacheKey from '../../exhibits/CacheKey'
import { JAX_CHAPTERS, JAX_PATH, jaxChapterAt, type JaxChapter } from '../../data/jax/track'
import { JAX_DIAGRAMS } from '../../data/jax/diagrams'
import type { Lab } from '../../data/track'

const INSTRUMENTS: Record<string, { d: string; t: string; p: string }> = {
  jit: {
    d: 'EX·13',
    t: 'the cache key, turned by hand',
    p: 'change one part of the key at a time and watch the cache hit or compile · the four parts are the ones chapter 03 names',
  },
}

const COLAB = 'https://colab.research.google.com/github/rudrite/kernels/blob/main/'
const lab = (designator: string, title: string, time: string, hardware: string, file: string): Lab => ({
  designator, title, time, hardware, colab: COLAB + file, notebook: file,
})
// One runnable lab per chapter that has one; the mastery ledger's labs
// auto-rule checks off when the card's mark-as-run is ticked.
const LABS: Record<string, Lab[]> = {
  tracing: [lab('LAB·J1', 'The trace, read raw', '~1.5 h', 'any machine', 'labs/jax/lab-j1-trace-read-raw.ipynb')],
  jit: [lab('LAB·J2', 'The recompile hunt', '~1.5 h', 'any machine', 'labs/jax/lab-j2-recompile-hunt.ipynb')],
  autodiff: [lab('LAB·J3', 'Own the derivative', '~2 h', 'any machine', 'labs/jax/lab-j3-own-the-derivative.ipynb')],
  sharding: [lab('LAB·J4', 'Eight fake devices', '~2 h', 'any machine', 'labs/jax/lab-j4-eight-fake-devices.ipynb')],
}

export function getStaticPaths() {
  return JAX_CHAPTERS.map((chapter) => ({ params: { id: chapter.id }, props: { chapter } }))
}

interface Props {
  chapter: JaxChapter
}
const { chapter } = Astro.props
const key = `jax:${chapter.id}`
const { prev, next } = jaxChapterAt(key)
const pad = (n: number) => String(n).padStart(2, '0')
const slug = (h: string) => h.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
const partLabel = chapter.part === 'i' ? 'part i, the model' : 'part ii, the practice'
// Presentation-owned diagram slots for chapters whose data carries none.
const EXTRA_DIAGRAMS: Record<string, { id: string; after: number }> = {
  'control-flow': { id: 'jax-scan', after: 2 },
  arrays: { id: 'jax-arrays', after: 0 },
  performance: { id: 'jax-timing', after: 0 },
  'training-run': { id: 'jax-run', after: 0 },
  vmap: { id: 'jax-vmap', after: 0 },
  state: { id: 'jax-state', after: 0 },
  pytrees: { id: 'jax-pytree', after: 0 },
  random: { id: 'jax-keys', after: 1 },
}
const slot = chapter.diagram ?? EXTRA_DIAGRAMS[chapter.id]
const diagram = slot ? JAX_DIAGRAMS[slot.id] : undefined
---

<Base
  title={`${chapter.title} — the JAX path — Rudrite Kernels`}
  description={chapter.lede}
>
  <section class="chapter-head">
    <div class="wrap">
      <p class="mono-label kicker">the jax path · chapter {pad(chapter.num)} of {JAX_PATH.length} · {partLabel}</p>
      <h1>{chapter.title}</h1>
      <p class="lede"><Rich text={chapter.lede} self={`/jax/${chapter.id}`} /></p>
      <p class="goal"><span class="mono-label">the goal</span> <Rich text={chapter.goal} self={`/jax/${chapter.id}`} /></p>
    </div>
  </section>

  <div class="wrap layout">
    <aside class="side">
      <nav class="pathmap" aria-label="The JAX path">
        <span class="mono-label toc-head">the jax path</span>
        <ol>
          {
            JAX_PATH.map((c) => (
              <li class={`${c.num === 9 ? 'part-break' : ''} ${c.key === key ? 'here' : ''}`}>
                <a href={c.href} data-chapter-key={c.key}>
                  <span class="pm-num">{pad(c.num)}</span>
                  <span class="pm-title">{c.title}</span>
                  <span class="pm-frac meas" data-work-frac={c.key} />
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <nav class="toc" aria-label="On this page">
        <span class="mono-label toc-head">on this page</span>
        <ol>
          {chapter.sections.map((sec) => <li><a href={`#${slug(sec.h)}`}>{sec.h}</a></li>)}
        </ol>
      </nav>
    </aside>

    <article class="main">
      <MasteryWork chapterKey={key} />

      {
        chapter.sections.map((sec, si) => (
          <section class="block prose">
            <SectionHead id={slug(sec.h)} eyebrow={`§ ${pad(si + 1)}`} title={sec.h.charAt(0).toUpperCase() + sec.h.slice(1)} />
            {sec.ps.map((p) =>
              p.startsWith('>> ') ? (
                <blockquote class="pull">{p.slice(3)}</blockquote>
              ) : (
                <p class="theory">
                  <Rich text={p} self={`/jax/${chapter.id}`} />
                </p>
              ),
            )}
            {sec.code && (
              <figure class="panel codefig">
                <figcaption class="provenance top">{sec.code.caption}</figcaption>
                <div class="codebody">
                  <Code code={sec.code.text} lang={sec.code.lang ?? 'python'} theme="vesper" />
                </div>
              </figure>
            )}
            {diagram && slot!.after === si && (
              <figure class="panel codefig">
                <figcaption class="provenance top">{diagram.caption}</figcaption>
                <BlockDiagram spec={diagram} />
              </figure>
            )}
          </section>
        ))
      }

      <section class="block">
        <SectionHead id="readings" eyebrow="assigned" title="Readings" />
        <ul class="readings">
          {
            chapter.readings.map((r) => (
              <li>
                <a href={r.url} target="_blank" rel="noopener">{r.label} ↗</a>
                <span class="r-note">{r.note}</span>
              </li>
            ))
          }
        </ul>
      </section>

      {
        LABS[chapter.id] && (
          <section class="block" id="labs">
            <SectionHead id="labs-head" eyebrow="runnable" title="Labs" />
            <div class="labgrid">
              {LABS[chapter.id]!.map((l) => (
                <LabCard lab={l} />
              ))}
            </div>
          </section>
        )
      }


      {
        INSTRUMENTS[chapter.id] && (
          <section class="block" id="instruments">
            <SectionHead id="instruments-head" eyebrow="live" title="Instrument" />
            <Exhibit designator={INSTRUMENTS[chapter.id]!.d} title={INSTRUMENTS[chapter.id]!.t} provenance={INSTRUMENTS[chapter.id]!.p}>
              <CacheKey client:visible />
            </Exhibit>
          </section>
        )
      }

      <nav class="pathpager" aria-label="The JAX path">
        <div class="pp-left">
          {prev ? <a class="pp-prev" href={prev.href}>← ch {pad(prev.num)} · {prev.title}</a> : <a class="pp-prev" href="/jax">← the jax path</a>}
          <span class="pp-work">this chapter's work · <span data-work-frac={key}>·</span></span>
        </div>
        {
          next ? (
            <a class="pp-next" href={next.href}>
              <span class="pp-k">next on the path</span>
              <span class="pp-t">ch {pad(next.num)} · {next.title} →</span>
            </a>
          ) : (
            <a class="pp-next" href="/">
              <span class="pp-k">the jax path ends here</span>
              <span class="pp-t">descend the kernel path next →</span>
            </a>
          )
        }
      </nav>
    </article>

    <aside class="right">
      <div class="rail">
        <div>
          <span class="rail-head">reading progress</span>
          <span class="progress-num meas">0%</span>
          <div class="progress-bar"><i></i></div>
        </div>
        <div>
          <span class="rail-head">this chapter</span>
          <div class="card">
            <div class="row"><span class="k">chapter</span><span>{pad(chapter.num)} of {JAX_PATH.length}</span></div>
            <div class="row"><span class="k">part</span><span>{partLabel}</span></div>
            <div class="row"><span class="k">readings</span><span>{chapter.readings.length} assigned</span></div>
          </div>
        </div>
        <div>
          <span class="rail-head">part of</span>
          <ul>
            <li><a href="/jax">the jax path · twelve chapters</a></li>
            <li><a href="/">the kernel path · the layer below</a></li>
          </ul>
        </div>
      </div>
    </aside>
  </div>
  <ReadingRails />
</Base>

<style>
  .layout { display: grid; grid-template-columns: 13.5rem minmax(0, 1fr) 13rem; gap: 3rem; padding-block: 2.5rem; }
  .side, .right { position: sticky; top: 2rem; align-self: start; }
  @media (max-width: 1240px) { .layout { grid-template-columns: 13.5rem minmax(0, 1fr); } .right { display: none; } }
  @media (max-width: 960px) { .layout { grid-template-columns: 1fr; } .side { display: none; } }

  .chapter-head { padding-block: 2rem 2.25rem; background: var(--paper-high); border-bottom: 1px solid var(--rule); }
  .chapter-head .kicker { color: var(--copper-deep); margin-bottom: 0.875rem; }
  .chapter-head h1 { font-size: clamp(1.875rem, 4.5vw, 2.75rem); font-weight: 600; letter-spacing: -0.01em; }
  .chapter-head .lede { margin-top: 0.75rem; font-size: 1.1875rem; color: var(--ink-mute); max-width: 62ch; }
  .chapter-head .goal { margin-top: 0.875rem; font-size: 0.9375rem; color: var(--ink); max-width: 70ch; border-left: 3px solid var(--copper-deep); padding-left: 0.875rem; }
  .chapter-head .goal .mono-label { color: var(--copper-deep); margin-right: 0.5rem; }

  .block { margin-top: 2.5rem; }
  .theory { margin-bottom: 1em; }

  .pull {
    margin: 1.25rem 0; padding: 0.25rem 0 0.25rem 1.125rem;
    border-left: 3px solid var(--copper-deep);
    font-family: var(--serif); font-style: italic; font-size: 1.1875rem; line-height: 1.5;
    color: var(--ink);
  }

  .pathmap ol { list-style: none; margin: 0.5rem 0 0; padding: 0; }
  .pathmap li.part-break { margin-top: 0.625rem; padding-top: 0.625rem; border-top: 1px solid var(--rule-soft); }
  .pathmap a { display: flex; align-items: baseline; gap: 0.5rem; padding: 0.22rem 0; text-decoration: none; color: var(--ink-mute); font-size: 0.8125rem; }
  .pathmap a:hover { color: var(--copper-deep); }
  .pathmap li.here a { color: var(--copper-deep); font-weight: 500; }
  .pm-num { font-family: var(--mono); font-size: 0.6875rem; color: var(--copper-deep); }
  .pm-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pm-frac { font-family: var(--mono); font-size: 0.625rem; color: var(--ink-mute); }
  :global(.pathmap a.p-done) .pm-frac, :global(.pathmap [data-chapter-key].p-done) .pm-frac { color: var(--pass); }
  .toc { margin-top: 1.5rem; }

  .codefig { margin: 1.25rem 0 0; }
  .codefig .top { border-top: none; border-bottom: 1px solid var(--panel-rule); }
  .codebody :global(pre) { margin: 0; padding: 0.875rem; overflow-x: auto; font-size: 0.8125rem; line-height: 1.65; background: transparent !important; }

  .labgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1rem; }
  .readings { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .readings li { display: flex; flex-direction: column; gap: 0.2rem; border: 1px solid var(--rule); background: var(--paper-high); padding: 0.75rem 1rem; }
  .readings a { font-family: var(--mono); font-size: 0.8125rem; color: var(--ink); text-decoration: none; }
  .readings a:hover { color: var(--copper-deep); text-decoration: underline; }
  .r-note { font-size: 0.8125rem; color: var(--ink-mute); }

  .pathpager { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; margin-top: 3.5rem; padding-top: 1.25rem; border-top: 1px solid var(--rule); }
  .pp-left { display: flex; flex-direction: column; gap: 0.375rem; }
  .pp-work { font-family: var(--mono); font-size: 0.6875rem; color: var(--ink-mute); }
  .pp-prev { font-family: var(--mono); font-size: 0.75rem; color: var(--ink-mute); text-decoration: none; }
  .pp-prev:hover { color: var(--copper-deep); }
  .pp-next { display: inline-flex; flex-direction: column; gap: 0.25rem; align-items: flex-end; text-align: right; text-decoration: none; border: 1px solid var(--copper-deep); background: var(--paper-high); padding: 0.625rem 0.875rem; border-radius: 2px; }
  .pp-next:hover { background: var(--paper); }
  .pp-k { font-family: var(--mono); font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-mute); }
  .pp-t { font-family: var(--mono); font-size: 0.8125rem; color: var(--copper-deep); }
</style>
