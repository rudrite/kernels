---
import { Code } from 'astro:components'
import Base from '../layouts/Base.astro'
import SectionHead from '../components/SectionHead.astro'
import Exhibit from '../components/Exhibit.astro'
import DotDecoder from '../exhibits/DotDecoder'
import ShapeOracle from '../exhibits/ShapeOracle'
import corpus from '../data/ir-corpus.json'
import opCards from '../data/op-cards.json'

interface Program {
  id: string
  title: string
  note: string
  source: string[]
  jaxpr: string[]
  stablehlo: string[]
}
const programs = corpus.programs as Program[]
const cards = Object.entries(opCards as Record<string, string>)
---

<Base
  title="The reading gym — Rudrite Kernels"
  description="Drills over a corpus of seventeen real programs: decode dimension_numbers on sight, predict shapes before the reveal, and read jaxpr and StableHLO until fluency."
>
  <section class="wrap head">
    <p class="mono-label kicker">the reading gym</p>
    <h1>Fluency is drills, not prose.</h1>
    <p class="prose lede">
      Seventeen real programs, traced and dumped: every jaxpr and StableHLO here was generated, never
      retyped, and every drill answer is computed from the same structured facts. Streaks persist in your
      browser and nowhere else. The bar, from the path's chapter 11: read any dump on sight.
    </p>
  </section>

  <section class="wrap block">
    <SectionHead id="drills" eyebrow="active recall, one tap" title="The drills" />
    <div class="drill-grid">
      <Exhibit designator="GYM·01" title="the dot_general decoder" provenance="instances extracted from the corpus jaxprs · 10 in a row is the pass bar">
        <DotDecoder client:visible />
      </Exhibit>
      <Exhibit designator="GYM·02" title="the shape oracle" provenance="equations sampled from 278 real eqns · distractors computed, never invented">
        <ShapeOracle client:visible />
      </Exhibit>
    </div>
  </section>

  <section class="wrap block">
    <SectionHead id="corpus" eyebrow="seventeen real programs" title="The corpus" />
    <p class="prose sec-lede">
      Pick a program, read it at both layers, and narrate what you see. When a dump stops feeling like a
      wall of text and starts reading like prose, move to a program you have not seen.
    </p>
    <div class="corpus-list">
      {
        programs.map((p) => (
          <details class="panel prog">
            <summary>
              <span class="designator">{p.id}</span>
              <span class="pt">{p.title}</span>
              <span class="pn">{p.note}</span>
            </summary>
            <div class="dumps">
              <div class="dump">
                <div class="provenance top">source</div>
                <Code code={p.source.join('\n')} lang="python" theme="vesper" />
              </div>
              <div class="dump">
                <div class="provenance top">jaxpr</div>
                <Code code={p.jaxpr.join('\n')} lang="haskell" theme="vesper" />
              </div>
              <div class="dump">
                <div class="provenance top">stablehlo</div>
                <Code code={p.stablehlo.join('\n')} lang="mlir" theme="vesper" />
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </section>

  <section class="wrap block">
    <SectionHead id="ops" eyebrow="every op the corpus uses" title="The op reference" />
    <div class="cards">
      {
        cards.map(([op, text]) => (
          <details class="panel card">
            <summary><span class="designator">{op}</span></summary>
            <p>{text}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .head { padding-block: clamp(2.5rem, 6vw, 4rem) 1rem; }
  .kicker { display: block; margin-bottom: 1.25rem; color: var(--copper-deep); }
  h1 { font-size: clamp(1.875rem, 4.5vw, 2.75rem); font-weight: 600; letter-spacing: -0.01em; }
  .lede { margin-top: 1.25rem; font-size: 1.125rem; }
  .block { padding-block: 2rem 0.5rem; }
  .sec-lede { color: var(--ink-mute); margin-bottom: 1.25rem; }

  .drill-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; align-items: start; }
  @media (max-width: 1000px) { .drill-grid { grid-template-columns: 1fr; } }

  .corpus-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .prog summary { display: flex; gap: 1rem; align-items: baseline; padding: 0.75rem 0.875rem; cursor: pointer; list-style: none; }
  .prog summary::-webkit-details-marker { display: none; }
  .prog .pt { color: var(--panel-ink); font-family: var(--mono); font-size: 0.875rem; }
  .prog .pn { color: var(--panel-mute); font-family: var(--mono); font-size: 0.75rem; flex: 1; }
  .prog[open] summary { border-bottom: 1px solid var(--panel-rule); }
  .dumps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--panel-rule); }
  @media (max-width: 1100px) { .dumps { grid-template-columns: 1fr; } }
  .dump { background: #101215; min-width: 0; }
  .dump .top { border-top: none; border-bottom: 1px solid var(--panel-rule); }
  .dump :global(pre) { margin: 0; padding: 0.75rem; overflow-x: auto; font-size: 0.6875rem; line-height: 1.55; background: transparent !important; max-height: 26rem; overflow-y: auto; }

  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.625rem; }
  @media (max-width: 1000px) { .cards { grid-template-columns: 1fr; } }
  .card summary { padding: 0.625rem 0.875rem; cursor: pointer; list-style: none; }
  .card summary::-webkit-details-marker { display: none; }
  .card p { padding: 0 0.875rem 0.75rem; font-size: 0.875rem; line-height: 1.55; color: var(--panel-ink); font-family: var(--serif); }
</style>
