---
import { Code } from 'astro:components'
import Base from '../layouts/Base.astro'
import Exhibit from '../components/Exhibit.astro'
import DotDecoder from '../exhibits/DotDecoder'
import ShapeOracle from '../exhibits/ShapeOracle'
import SpotDecision from '../exhibits/SpotDecision'
import CorpusXray from '../exhibits/CorpusXray'
import corpus from '../data/ir-corpus.json'
import opCards from '../data/op-cards.json'

interface Program {
  id: string
  title: string
  note: string
  source: string[]
  jaxpr: string[]
  stablehlo: string[]
}
const programs = corpus.programs as Program[]
const cards = Object.entries(opCards as Record<string, string>)
---

<Base
  title="The reading gym — Rudrite Kernels"
  description="Drills over a corpus of seventeen real programs: decode dimension_numbers on sight, predict shapes before the reveal, and read jaxpr and StableHLO until fluency."
>
  <div class="ws-ground">
    <section class="wband">
      <div class="wrap wgrid">
        <span class="wtag">the gym</span>
        <div>
          <p class="mono-label serves">serves chapters 02 · 03 · 04 · 12 — the path assigns each drill with a streak target; the streaks check themselves off</p>
          <h1 class="wh1">Fluency is drills, not prose.</h1>
          <p class="wlede">
            Seventeen real programs, traced and dumped: every jaxpr and StableHLO here was generated,
            never retyped, and every drill answer is computed from the same structured facts. Streaks
            persist in your browser and nowhere else. The bar, from chapter 12: read any dump on sight.
          </p>
        </div>
      </div>
    </section>

    <section class="wband" id="drills">
      <div class="wrap wgrid">
        <span class="wtag">drills<br />01-03</span>
        <div>
          <h2 class="wh2">Active recall, one tap</h2>
          <div class="drill-grid">
            <Exhibit designator="GYM·01" title="the dot_general decoder" provenance="instances extracted from the corpus jaxprs · 10 in a row is the fluency bar">
              <DotDecoder client:visible />
            </Exhibit>
            <Exhibit designator="GYM·02" title="the shape oracle" provenance="equations sampled from 278 real eqns · distractors computed, never invented">
              <ShapeOracle client:visible />
            </Exhibit>
          </div>
          <div class="drill-wide">
            <Exhibit designator="GYM·03" title="spot the decision" provenance="find the line the framework wrote for you: upcasts, hidden broadcasts, remat marks · targets computed by scanning the real dumps">
              <SpotDecision client:visible />
            </Exhibit>
          </div>
        </div>
      </div>
    </section>

    <section class="wband" id="xray">
      <div class="wrap wgrid">
        <span class="wtag">drill 04</span>
        <div>
          <h2 class="wh2">The x-ray, on any program</h2>
          <p class="wlede narrow">
            Pick a program and hover either column: the same computation lights at both layers. The
            mappings are computed mechanically from op order; unmapped lines are conservative skips,
            never absences.
          </p>
          <Exhibit designator="GYM·04" title="the corpus x-ray" provenance="17 programs, 236 sync groups, all derived by the mapping script · nothing hand-drawn">
            <CorpusXray client:visible />
          </Exhibit>
        </div>
      </div>
    </section>

    <section class="wband" id="corpus">
      <div class="wrap wgrid">
        <span class="wtag">the corpus</span>
        <div>
          <h2 class="wh2">Seventeen real programs</h2>
          <p class="wlede narrow">
            Read them at every layer and narrate what you see. When a dump stops feeling like a wall of
            text and starts reading like prose, move to one you have not seen.
          </p>
          <div class="corpus-list">
            {
              programs.map((p) => (
                <details class="panel prog">
                  <summary>
                    <span class="chev" aria-hidden="true">▸</span>
                    <span class="designator">{p.id}</span>
                    <span class="pt">{p.title}</span>
                    <span class="pn">{p.note}</span>
                    <span class="hint">source · jaxpr · stablehlo</span>
                  </summary>
                  <div class="dumps">
                    <div class="dump">
                      <div class="provenance top">source</div>
                      <Code code={p.source.join('\n')} lang="python" theme="vesper" />
                    </div>
                    <div class="dump">
                      <div class="provenance top">jaxpr</div>
                      <Code code={p.jaxpr.join('\n')} lang="haskell" theme="vesper" />
                    </div>
                    <div class="dump">
                      <div class="provenance top">stablehlo</div>
                      <Code code={p.stablehlo.join('\n')} lang="mlir" theme="vesper" />
                    </div>
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </div>

  <section class="wband-light" id="ops">
    <div class="wrap wgrid">
      <span class="wtag">reference</span>
      <div>
        <h2 class="wh2">The op reference</h2>
        <p class="wlede narrow">Back on paper to read: every op the corpus uses, one card each.</p>
        <input type="search" class="op-filter" placeholder="filter ops: dot, reduce, convert…" aria-label="Filter ops" />
        <dl class="cards">
          {
            cards.map(([op, text]) => (
              <div class="card" data-op={op}>
                <dt><code class="ri">{op}</code></dt>
                <dd>{text}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mono-label no-match" hidden>no ops match</p>
      </div>
    </div>
  </section>

  <script>
    const input = document.querySelector<HTMLInputElement>('.op-filter')
    const entries = Array.from(document.querySelectorAll<HTMLElement>('.card[data-op]'))
    const empty = document.querySelector<HTMLElement>('.no-match')
    input?.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase()
      let shown = 0
      for (const el of entries) {
        const hit = !q || (el.getAttribute('data-op') ?? '').toLowerCase().includes(q) || (el.textContent ?? '').toLowerCase().includes(q)
        el.hidden = !hit
        if (hit) shown++
      }
      if (empty) empty.hidden = shown > 0
    })
  </script>
</Base>

<style>
  .serves { margin-bottom: 1rem; letter-spacing: 0.04em; }
  .wh1 + .wlede { margin-top: 1rem; }
  .wlede.narrow { margin-bottom: 1.25rem; }
  h2.wh2 { margin-bottom: 1rem; }

  .drill-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; align-items: start; }
  @media (max-width: 1000px) { .drill-grid { grid-template-columns: 1fr; } }
  .drill-wide { margin-top: 1.25rem; }

  .corpus-list { display: flex; flex-direction: column; gap: 0.5rem; }
  
  .prog summary { display: flex; gap: 1rem; align-items: baseline; padding: 0.75rem 0.875rem; cursor: pointer; list-style: none; }
  .prog summary::-webkit-details-marker { display: none; }
  .prog summary:hover { background: #16191d; }
  .prog .chev { color: var(--copper); }
  .prog[open] .chev { display: inline-block; transform: rotate(90deg); }
  .prog .pt { color: var(--panel-ink); font-family: var(--mono); font-size: 0.875rem; }
  .prog .pn { color: var(--panel-mute); font-family: var(--mono); font-size: 0.75rem; flex: 1; }
  .prog .hint { color: var(--panel-mute); font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.05em; }
  .prog[open] summary { border-bottom: 1px solid var(--panel-rule); }
  .dumps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--panel-rule); }
  @media (max-width: 1100px) { .dumps { grid-template-columns: 1fr; } }
  .dump { background: #101215; min-width: 0; }
  .dump .top { border-top: none; border-bottom: 1px solid var(--panel-rule); }
  .dump :global(pre) { margin: 0; padding: 0.75rem; overflow-x: auto; font-size: 0.6875rem; line-height: 1.55; background: transparent !important; max-height: 26rem; overflow-y: auto; }

  .op-filter {
    font-family: var(--mono); font-size: 0.8125rem; color: var(--ink);
    background: var(--paper-high); border: 1px solid var(--rule); border-radius: 2px;
    padding: 0.5rem 0.75rem; width: min(100%, 24rem); margin-bottom: 1.25rem;
  }
  .op-filter:focus-visible { outline: 2px solid var(--copper-deep); outline-offset: 1px; }
  .cards { columns: 2; column-gap: 2.5rem; margin: 0; }
  @media (max-width: 900px) { .cards { columns: 1; } }
  .card { break-inside: avoid; padding-block: 0.625rem; border-bottom: 1px solid var(--rule-soft); }
  .card dt { margin-bottom: 0.25rem; }
  .card dd { margin: 0; font-size: 0.9375rem; line-height: 1.6; color: var(--ink); font-family: var(--serif); }
  .no-match { margin-top: 1rem; }
</style>
