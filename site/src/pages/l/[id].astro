---
import { Code } from 'astro:components'
import MlirCode from '../../components/MlirCode.astro'
import Base from '../../layouts/Base.astro'
import Spine from '../../components/Spine.astro'
import Rich from '../../components/Rich.astro'
import SectionHead from '../../components/SectionHead.astro'
import ReadingRails from '../../components/ReadingRails.astro'
import PathPager from '../../components/PathPager.astro'
import MasteryWork from '../../components/MasteryWork.astro'
import SpecimenSlice from '../../components/SpecimenSlice.astro'
import MiniMap from '../../components/MiniMap.astro'
import LessonList from '../../components/LessonList.astro'
import GuideSections from '../../components/GuideSections.astro'
import { lessonsOf, claimedGuideSections } from '../../data/lessons'
import LabCard from '../../components/LabCard.astro'
import { LAYERS, STAGES, type Lab } from '../../data/track'
import { LAYER_DOCS, layerDoc } from '../../data/layers'
import irData from '../../data/ir-attention.json'

export function getStaticPaths() {
  return LAYER_DOCS.map((doc) => ({ params: { id: doc.id }, props: { doc } }))
}

const { doc } = Astro.props

const COLAB = 'https://colab.research.google.com/github/rudrite/kernels/blob/main/'
const lab = (designator: string, title: string, time: string, hardware: string, file: string): Lab => ({
  designator, title, time, hardware, colab: COLAB + file, notebook: file,
})
// One runnable lab per layer that has one; the mastery ledger's labs
// auto-rule checks off when the card's mark-as-run is ticked.
const LABS: Record<string, Lab[]> = {
  xla: [lab('LAB·L1', 'One program, every artifact', '~1 h', 'any machine', 'labs/l/lab-l1-artifact-descent.ipynb')],
}
const order = LAYERS.map((l) => l.id)
const idx = order.indexOf(doc.id)
const drillStage = doc.drills ? STAGES.find((s) => s.id === doc.drills!.stage) : undefined

// The full guide, when this chapter has one: a JSON of sections whose blocks
// are prose, verified code, cross-reference callouts, or pulls from the
// generated corpora (never retyped).
interface GuideBlock {
  kind: 'p' | 'code' | 'callout' | 'gallery' | 'cf' | 'mistake' | 'exercise' | 'diagram'
  text?: string
  caption?: string
  lang?: string
  label?: string
  href?: string
  id?: string
  which?: 'source' | 'jaxpr' | 'stablehlo'
  lines?: [number, number]
}
interface GuideSection {
  h: string
  blocks: GuideBlock[]
}
const guideModules = import.meta.glob('../../data/guides/*.json', { eager: true }) as Record<
  string,
  { default: { sections: GuideSection[] } }
>
const guide = guideModules[`../../data/guides/${doc.id}.json`]?.default
// Guide sections that already live inside lessons (this unit's or another's)
// are told there; the hub renders only what remains unclaimed.
const claimed = claimedGuideSections(doc.id)
const remaining = guide ? guide.sections.map((_, i) => i).filter((i) => !claimed.has(i)) : []
const showGuide = remaining.length > 0

const irText = (which: 'source' | 'jaxpr' | 'stablehlo', lines?: [number, number]) => {
  const all = irData[which] as string[]
  const slice = lines ? all.slice(lines[0], lines[1] + 1) : all
  return slice.join('\n')
}

const slug = (h: string) => h.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
---

<Base title={`${doc.title} · the stack, layer by layer · Rudrite Kernels`} description={doc.lede}>
  <section class="chapter-head">
    <div class="wrap">
      <p class="mono-label kicker">the path · chapter {String(idx + 1).padStart(2, '0')} of 15 · part i, the descent</p>
      <h1>{doc.title}</h1>
      <p class="lede"><Rich text={doc.lede} self={`/l/${doc.id}`} /></p>
    </div>
  </section>

  <div class="wrap layout">
    <aside class="side">
      <MiniMap unit={`l:${doc.id}`} />
      <Spine currentLayer={doc.id} />
      <nav class="toc" aria-label="On this page">
        <span class="mono-label toc-head">on this page</span>
        <ol>
          {doc.sections.map((sec) => <li><a href={`#${slug(sec.h)}`}>{sec.h}</a></li>)}
          {showGuide && remaining.map((i) => <li class="toc-guide"><a href={`#${slug(guide!.sections[i]!.h)}`}>{guide!.sections[i]!.h}</a></li>)}
        </ol>
      </nav>
    </aside>

    <article class="main">
      <MasteryWork chapterKey={`l:${doc.id}`} />
      <SpecimenSlice unit={`l:${doc.id}`} />

      {
        doc.sections.map((sec) => (
          <section class="block prose">
            <SectionHead id={slug(sec.h)} eyebrow="the layer" title={sec.h.charAt(0).toUpperCase() + sec.h.slice(1)} />
            {sec.ps.map((p) => (
              <p class="theory">
                <Rich text={p} self={`/l/${doc.id}`} />
              </p>
            ))}
            {sec.code && (
              <figure class="panel codefig">
                <figcaption class="provenance top">{sec.code.caption}</figcaption>
                <div class="codebody">
                  {sec.code.fromIR === 'stablehlo' || sec.code.lang === 'mlir' ? (
                    <MlirCode code={sec.code.fromIR ? irText(sec.code.fromIR, sec.code.lines) : sec.code.text!} />
                  ) : (
                    <Code
                      code={sec.code.fromIR ? irText(sec.code.fromIR, sec.code.lines) : sec.code.text!}
                      lang={sec.code.fromIR === 'jaxpr' ? 'haskell' : 'python'}
                      theme="vesper"
                    />
                  )}
                </div>
              </figure>
            )}
          </section>
        ))
      }

      {
        lessonsOf(`l:${doc.id}`).length > 0 && (
          <section class="block">
            <SectionHead id="lessons" eyebrow="go deeper, in order" title="Lessons" />
            <LessonList unit={`l:${doc.id}`} />
          </section>
        )
      }

      {
        LABS[doc.id] && (
          <section class="block" id="labs">
            <SectionHead id="labs-head" eyebrow="runnable" title="Labs" />
            <div class="labgrid">
              {LABS[doc.id]!.map((l) => (
                <LabCard lab={l} />
              ))}
            </div>
          </section>
        )
      }

      {
        showGuide && (
          <div class="plate guide-open">
            <span class="mono-label">the full guide</span>
            <p>
              Everything below is the working reference for this layer: every snippet ran before it
              was printed, every dump was generated, and the callouts point at the instruments,
              exhibits, and outside material that go deeper.
            </p>
          </div>
        )
      }
      {showGuide && <GuideSections guideId={doc.id} sections={remaining} self={`/l/${doc.id}`} numbering="guide" />}

      {
        drillStage && doc.drills && (
          <section class="block">
            <div class="plate drill">
              <span class="mono-label">later on the path</span>
              <span class="dtext">{doc.drills.label} (chapter {String(10 + drillStage.num).padStart(2, '0')}). Keep descending; the path arrives there in order.</span>
            </div>
          </section>
        )
      }

      <PathPager chapterKey={`l:${doc.id}`} />
    </article>

    <aside class="right">
      <div class="rail">
        <div>
          <span class="rail-head">reading progress</span>
          <span class="progress-num meas">0%</span>
          <div class="progress-bar"><i></i></div>
        </div>
        <div>
          <span class="rail-head">this layer</span>
          <div class="card">
            <div class="row"><span class="k">chapter</span><span>{String(idx + 1).padStart(2, '0')} of 15</span></div>
            <div class="row"><span class="k">part</span><span>i · the descent</span></div>
            {lessonsOf(`l:${doc.id}`).length > 0 && <div class="row"><span class="k">lessons</span><span>{lessonsOf(`l:${doc.id}`).length} in order</span></div>}
            {showGuide && <div class="row"><span class="k">guide</span><span>{remaining.length} sections</span></div>}
            {drillStage && <div class="row"><span class="k">drilled in</span><span>stage {drillStage.num}</span></div>}
          </div>
        </div>
        <div>
          <span class="rail-head">part of</span>
          <ul>
            <li><a href="/">the path · fifteen chapters</a></li>
          </ul>
        </div>
      </div>
    </aside>
  </div>
  <ReadingRails />
</Base>

<style>
  .layout { display: grid; grid-template-columns: 12.5rem minmax(0, 1fr) 13rem; gap: 3rem; padding-block: 2.5rem; }
  .side, .right { position: sticky; top: 2rem; align-self: start; }
  @media (max-width: 1240px) { .layout { grid-template-columns: 12.5rem minmax(0, 1fr); } .right { display: none; } }
  @media (max-width: 960px) { .layout { grid-template-columns: minmax(0, 1fr); } .side { display: none; } }

  .chapter-head {
    padding-block: 2rem 2.25rem; background: var(--plate); border-bottom: 2px solid var(--edge);
    background-image: repeating-linear-gradient(to bottom, var(--scan) 0 1px, transparent 1px 3px);
  }
  .chapter-head .kicker { margin-bottom: 0.875rem; }
  .chapter-head .lede { margin-top: 0.9rem; color: var(--ink-mute); max-width: 62ch; }
  .block { margin-top: 2.5rem; }
  .block > h2 { margin-bottom: 0.875rem; }
  .theory { margin-bottom: 1em; }

  .toc-guide a { color: var(--accent-deep); }

  .labgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1rem; }
  .plate.guide-open { margin-top: 3rem; border-left: 4px solid var(--accent); padding: 1rem 1.25rem; }
  .guide-open .mono-label { color: var(--accent); text-shadow: var(--bloom); }
  .guide-open p { margin-top: 0.375rem; font-size: 0.9375rem; color: var(--ink-mute); max-width: 70ch; }

  .codefig { margin: 1.25rem 0 0; }
  .codefig .top { border-top: none; border-bottom: 1px solid var(--panel-rule); }
  .codebody :global(pre) { margin: 0; padding: 0.875rem; overflow-x: auto; font-size: 0.8125rem; line-height: 1.65; background: transparent !important; }
  article.main { counter-reset: exercise; }

  .drill { display: inline-flex; flex-direction: column; gap: 0.375rem; padding: 0.875rem 1.125rem; }
  .drill .mono-label { color: var(--accent); text-shadow: var(--bloom); }
  .dtext { font-family: var(--mono); font-size: 0.8125rem; color: var(--ink-mute); }
</style>
