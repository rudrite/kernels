---
import { Code } from 'astro:components'
import Base from '../../layouts/Base.astro'
import Spine from '../../components/Spine.astro'
import Rich from '../../components/Rich.astro'
import SectionHead from '../../components/SectionHead.astro'
import ReadingRails from '../../components/ReadingRails.astro'
import PathPager from '../../components/PathPager.astro'
import MasteryWork from '../../components/MasteryWork.astro'
import { LAYERS, STAGES } from '../../data/track'
import { LAYER_DOCS, layerDoc } from '../../data/layers'
import irData from '../../data/ir-attention.json'
import gallery from '../../data/transform-gallery.json'
import cfCorpus from '../../data/cf-corpus.json'
import mistakes from '../../data/mistakes.json'

export function getStaticPaths() {
  return LAYER_DOCS.map((doc) => ({ params: { id: doc.id }, props: { doc } }))
}

const { doc } = Astro.props
const order = LAYERS.map((l) => l.id)
const idx = order.indexOf(doc.id)
const drillStage = doc.drills ? STAGES.find((s) => s.id === doc.drills!.stage) : undefined

// The full guide, when this chapter has one: a JSON of sections whose blocks
// are prose, verified code, cross-reference callouts, or pulls from the
// generated corpora (never retyped).
interface GuideBlock {
  kind: 'p' | 'code' | 'callout' | 'gallery' | 'cf' | 'mistake' | 'exercise'
  text?: string
  caption?: string
  lang?: string
  label?: string
  href?: string
  id?: string
  which?: 'source' | 'jaxpr' | 'stablehlo'
  lines?: [number, number]
}
interface GuideSection {
  h: string
  blocks: GuideBlock[]
}
const guideModules = import.meta.glob('../../data/guides/*.json', { eager: true }) as Record<
  string,
  { default: { sections: GuideSection[] } }
>
const guide = guideModules[`../../data/guides/${doc.id}.json`]?.default

const irText = (which: 'source' | 'jaxpr' | 'stablehlo', lines?: [number, number]) => {
  const all = irData[which] as string[]
  const slice = lines ? all.slice(lines[0], lines[1] + 1) : all
  return slice.join('\n')
}

const galleryVariant = (id: string) => (gallery.variants as { id: string; title: string; note: string; jaxpr: string[] }[]).find((v) => v.id === id)
const cfProgram = (id: string) => (cfCorpus.programs as { id: string; title: string; note: string; source: string[]; jaxpr: string[]; stablehlo: string[] }[]).find((p) => p.id === id)
const mistakeById = (id: string) => (mistakes as { id: string; title: string; error: string }[]).find((m) => m.id === id)

const slug = (h: string) => h.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
---

<Base title={`${doc.title} — the stack, layer by layer — Rudrite Kernels`} description={doc.lede}>
  <section class="chapter-head">
    <div class="wrap">
      <p class="mono-label kicker">the path · chapter {String(idx + 1).padStart(2, '0')} of 15 · part i, the descent</p>
      <h1>{doc.title}</h1>
      <p class="lede"><Rich text={doc.lede} /></p>
    </div>
  </section>

  <div class="wrap layout">
    <aside class="side">
      <Spine currentLayer={doc.id} />
      <nav class="toc" aria-label="On this page">
        <span class="mono-label toc-head">on this page</span>
        <ol>
          {doc.sections.map((sec) => <li><a href={`#${slug(sec.h)}`}>{sec.h}</a></li>)}
          {guide && guide.sections.map((sec) => <li class="toc-guide"><a href={`#${slug(sec.h)}`}>{sec.h}</a></li>)}
        </ol>
      </nav>
    </aside>

    <article class="main">
      <MasteryWork chapterKey={`l:${doc.id}`} />

      {
        doc.sections.map((sec) => (
          <section class="block prose">
            <SectionHead id={slug(sec.h)} eyebrow="the layer" title={sec.h.charAt(0).toUpperCase() + sec.h.slice(1)} />
            {sec.ps.map((p) => (
              <p class="theory">
                <Rich text={p} />
              </p>
            ))}
            {sec.code && (
              <figure class="panel codefig">
                <figcaption class="provenance top">{sec.code.caption}</figcaption>
                <div class="codebody">
                  <Code
                    code={sec.code.fromIR ? irText(sec.code.fromIR, sec.code.lines) : sec.code.text!}
                    lang={sec.code.fromIR === 'stablehlo' ? 'mlir' : sec.code.fromIR === 'jaxpr' ? 'haskell' : sec.code.lang ?? 'python'}
                    theme="vesper"
                  />
                </div>
              </figure>
            )}
          </section>
        ))
      }

      {
        guide && (
          <div class="guide-open">
            <span class="mono-label">the full guide</span>
            <p>
              Everything below is the working reference for this layer: every snippet ran before it
              was printed, every dump was generated, and the callouts point at the instruments,
              exhibits, and outside material that go deeper.
            </p>
          </div>
        )
      }
      {
        guide &&
        guide.sections.map((sec, sn) => (
          <section class="block prose">
            <SectionHead id={slug(sec.h)} eyebrow={`guide § ${String(sn + 1).padStart(2, '0')}`} title={sec.h.charAt(0).toUpperCase() + sec.h.slice(1)} />
            {sec.blocks.map((b) => {
              if (b.kind === 'p') return (
                <p class="theory">
                  <Rich text={b.text!} />
                </p>
              )
              if (b.kind === 'code') return (
                <figure class="panel codefig">
                  <figcaption class="provenance top">{b.caption}</figcaption>
                  <div class="codebody">
                    <Code code={b.text!} lang={(b.lang ?? 'python') as 'python' | 'mlir'} theme="vesper" />
                  </div>
                </figure>
              )
              if (b.kind === 'gallery') {
                const v = galleryVariant(b.id!)
                if (!v) return null
                return (
                  <figure class="panel codefig">
                    <figcaption class="provenance top">{v.title} · {v.note} · generated by gen_transform_gallery.py</figcaption>
                    <div class="codebody">
                      <Code code={(b.lines ? v.jaxpr.slice(b.lines[0], b.lines[1] + 1) : v.jaxpr).join('\n')} lang="haskell" theme="vesper" />
                    </div>
                  </figure>
                )
              }
              if (b.kind === 'cf') {
                const p = cfProgram(b.id!)
                if (!p) return null
                const text = (p[b.which ?? 'stablehlo'] as string[])
                return (
                  <figure class="panel codefig">
                    <figcaption class="provenance top">{p.title} · generated by gen_cf_corpus.py</figcaption>
                    <div class="codebody">
                      <Code
                        code={(b.lines ? text.slice(b.lines[0], b.lines[1] + 1) : text).join('\n')}
                        lang={b.which === 'stablehlo' ? 'mlir' : b.which === 'jaxpr' ? 'haskell' : 'python'}
                        theme="vesper"
                      />
                    </div>
                  </figure>
                )
              }
              if (b.kind === 'mistake') {
                const m = mistakeById(b.id!)
                if (!m) return null
                return (
                  <figure class="panel codefig">
                    <figcaption class="provenance top">museum exhibit: {m.title} · the error, verbatim</figcaption>
                    <div class="codebody errbody">
                      <pre>{b.lines ? m.error.split('\n').slice(b.lines[0], b.lines[1] + 1).join('\n') : m.error}</pre>
                    </div>
                  </figure>
                )
              }
              if (b.kind === 'exercise') return (
                <div class="exercise">
                  <span class="mono-label ex-tag">exercise</span>
                  <span class="ex-text"><Rich text={b.text!} /></span>
                </div>
              )
              if (b.kind === 'callout') return (
                <aside class="crossref">
                  <span class="mono-label">{b.label}</span>
                  {b.href ? (
                    <a href={b.href} target={b.href.startsWith('http') ? '_blank' : undefined} rel={b.href.startsWith('http') ? 'noopener' : undefined}>
                      <Rich text={b.text!} />
                      {b.href.startsWith('http') && ' ↗'}
                    </a>
                  ) : (
                    <span class="crossref-text"><Rich text={b.text!} /></span>
                  )}
                </aside>
              )
              return null
            })}
          </section>
        ))
      }

      {
        drillStage && doc.drills && (
          <section class="block">
            <div class="drill">
              <span class="mono-label">later on the path</span>
              <span class="dtext">{doc.drills.label} (chapter {String(10 + drillStage.num).padStart(2, '0')}). Keep descending; the path arrives there in order.</span>
            </div>
          </section>
        )
      }

      <PathPager chapterKey={`l:${doc.id}`} />
    </article>

    <aside class="right">
      <div class="rail">
        <div>
          <span class="rail-head">reading progress</span>
          <span class="progress-num meas">0%</span>
          <div class="progress-bar"><i></i></div>
        </div>
        <div>
          <span class="rail-head">this layer</span>
          <div class="card">
            <div class="row"><span class="k">chapter</span><span>{String(idx + 1).padStart(2, '0')} of 15</span></div>
            <div class="row"><span class="k">part</span><span>i · the descent</span></div>
            {guide && <div class="row"><span class="k">guide</span><span>{guide.sections.length} sections</span></div>}
            {drillStage && <div class="row"><span class="k">drilled in</span><span>stage {drillStage.num}</span></div>}
          </div>
        </div>
        <div>
          <span class="rail-head">part of</span>
          <ul>
            <li><a href="/">the path · fifteen chapters</a></li>
          </ul>
        </div>
      </div>
    </aside>
  </div>
  <ReadingRails />
</Base>

<style>
  .layout { display: grid; grid-template-columns: 12.5rem minmax(0, 1fr) 13rem; gap: 3rem; padding-block: 2.5rem; }
  .side, .right { position: sticky; top: 2rem; align-self: start; }
  @media (max-width: 1240px) { .layout { grid-template-columns: 12.5rem minmax(0, 1fr); } .right { display: none; } }
  @media (max-width: 960px) { .layout { grid-template-columns: 1fr; } .side { display: none; } }

  .chapter-head { padding-block: 2rem 2.25rem; background: var(--paper-high); border-bottom: 1px solid var(--rule); }
  .chapter-head .kicker { color: var(--copper-deep); margin-bottom: 0.875rem; }
  .chapter-head h1 { font-size: clamp(1.875rem, 4.5vw, 2.75rem); font-weight: 600; letter-spacing: -0.01em; }
  .chapter-head .lede { margin-top: 0.75rem; font-size: 1.1875rem; color: var(--ink-mute); max-width: 62ch; }
  .block { margin-top: 2.5rem; }
  .block > h2 { margin-bottom: 0.875rem; }
  .theory { margin-bottom: 1em; }

  .toc-guide a { color: var(--copper-deep); }

  .guide-open { margin-top: 3rem; border: 1px solid var(--rule); border-left: 3px solid var(--copper-deep); background: var(--paper-high); padding: 1rem 1.25rem; }
  .guide-open p { margin-top: 0.375rem; font-size: 0.9375rem; color: var(--ink-mute); max-width: 70ch; }

  .codefig { margin: 1.25rem 0 0; }
  .codefig .top { border-top: none; border-bottom: 1px solid var(--panel-rule); }
  .codebody :global(pre) { margin: 0; padding: 0.875rem; overflow-x: auto; font-size: 0.8125rem; line-height: 1.65; background: transparent !important; }
  .errbody pre { color: #d4a09a; font-family: var(--mono); white-space: pre-wrap; }

  .exercise { display: flex; flex-direction: column; gap: 0.375rem; border: 1px solid var(--rule); border-left: 3px solid var(--copper-deep); background: var(--paper-high); padding: 0.875rem 1.125rem; margin: 1rem 0; counter-increment: exercise; }
  .exercise .ex-tag { color: var(--copper-deep); }
  .exercise .ex-tag::after { content: " · " counter(exercise, decimal-leading-zero); }
  .exercise .ex-text { font-size: 0.9375rem; line-height: 1.65; color: var(--ink); max-width: 68ch; }
  article.main { counter-reset: exercise; }

  .crossref { display: flex; flex-direction: column; gap: 0.25rem; border: 1px solid var(--rule); background: var(--paper-high); padding: 0.75rem 1rem; margin: 1rem 0; }
  .crossref a, .crossref .crossref-text { font-family: var(--mono); font-size: 0.8125rem; color: var(--ink); text-decoration: none; }
  .crossref a:hover { color: var(--copper-deep); text-decoration: underline; }

  .drill { display: inline-flex; flex-direction: column; gap: 0.375rem; border: 1px solid var(--rule); background: var(--paper-high); padding: 0.875rem 1.125rem; }
  .dtext { font-family: var(--mono); font-size: 0.8125rem; color: var(--ink-mute); }
</style>
