---
import LessonPage from '../../../components/LessonPage.astro'
import { ALL_UNIT_LESSONS } from '../../../data/lessons'
import { chapterAt } from '../../../lib/path'

export function getStaticPaths() {
  return ALL_UNIT_LESSONS.filter((u) => u.unit.startsWith('l:')).flatMap((u) =>
    u.lessons.map((l) => ({ params: { id: u.unit.slice(2), lesson: l.id }, props: { unit: u.unit, lessonId: l.id } })),
  )
}

interface Props {
  unit: string
  lessonId: string
}
const { unit, lessonId } = Astro.props
const { current } = chapterAt(unit)
---

<LessonPage
  unit={unit}
  unitTitle={current.title}
  unitHref={current.href}
  course="the kernel path"
  courseHref="/"
  lessonId={lessonId}
/>
