---
import { Code } from 'astro:components'
import Base from '../layouts/Base.astro'
import mistakes from '../data/mistakes.json'

interface Mistake {
  id: string
  title: string
  snippet: string
  error: string
  fix: string
  why: string
}
const entries = mistakes as Mistake[]
const pad = (n: number) => String(n).padStart(2, '0')
---

<Base
  title="The mistake museum — Rudrite Kernels"
  description="Six real Pallas failures, reproduced and captured: the failing code, the exact error text, the fix, and the rule that prevents each."
>
  <div class="ws-ground">
    <section class="wband">
      <div class="wrap wgrid">
        <span class="wtag">the museum</span>
        <div>
          <p class="mono-label serves">assigned reading in chapter 11 · every error below was reproduced for real; the text is what the interpreter said</p>
          <h1 class="wh1">Meet every failure in a toy first.</h1>
          <p class="wlede">
            Each exhibit ran, failed, and was captured: the snippet, the verbatim error (paths shortened),
            the fix, and the rule that prevents it. Read them before your first kernel and again after;
            the error messages start making sense the second time.
          </p>
        </div>
      </div>
    </section>

    {
      entries.map((m, i) => (
        <section class={`wband ${i % 2 === 1 ? 'alt' : ''}`} id={m.id}>
          <div class="wrap wgrid">
            <span class="wtag">exhibit<br />{pad(i + 1)}/{pad(entries.length)}</span>
            <article>
              <h2 class="wh2">{m.title}</h2>
              <p class="why">{m.why}</p>
              <div class="pair">
                <figure class="panel half">
                  <figcaption class="provenance top fail">the failing code</figcaption>
                  <div class="codebody"><Code code={m.snippet} lang="python" theme="vesper" /></div>
                  <figcaption class="provenance err">{m.error}</figcaption>
                </figure>
                <figure class="panel half">
                  <figcaption class="provenance top pass">the fix</figcaption>
                  <div class="codebody"><Code code={m.fix} lang="python" theme="vesper" /></div>
                </figure>
              </div>
            </article>
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .serves { margin-bottom: 1rem; letter-spacing: 0.04em; }
  
  h2.wh2 { margin-bottom: 0.75rem; }
  .why { font-family: var(--serif); font-size: 1rem; line-height: 1.7; color: var(--ink); max-width: 66ch; margin-bottom: 1.25rem; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; align-items: start; }
  @media (max-width: 1100px) { .pair { grid-template-columns: 1fr; } }
  .half { margin: 0; }
  .half .top { border-top: none; border-bottom: 1px solid var(--panel-rule); }
  .half .top.fail { color: var(--fail); }
  .half .top.pass { color: var(--pass); }
  .codebody :global(pre) { margin: 0; padding: 0.75rem 0.875rem; overflow-x: auto; font-size: 0.71875rem; line-height: 1.55; background: transparent !important; }
  .err { color: var(--fail); white-space: pre-wrap; }
</style>
