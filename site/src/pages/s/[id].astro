---
import Base from '../../layouts/Base.astro'
import Rich from '../../components/Rich.astro'
import TitleBlock from '../../components/TitleBlock.astro'
import SectionHead from '../../components/SectionHead.astro'
import ReadingRails from '../../components/ReadingRails.astro'
import GateStamp from '../../components/GateStamp.astro'
import LabCard from '../../components/LabCard.astro'
import Spine from '../../components/Spine.astro'
import Exhibit from '../../components/Exhibit.astro'
import NotebookPeek from '../../components/NotebookPeek.astro'
import MemoryHierarchy from '../../components/MemoryHierarchy.astro'
import Choreographer from '../../exhibits/Choreographer'
import Roofline from '../../exhibits/Roofline'
import IRXray from '../../exhibits/IRXray'
import BlockSpecSandbox from '../../exhibits/BlockSpecSandbox'
import SemTimeline from '../../exhibits/SemTimeline'
import Checklist from '../../exhibits/Checklist'
import CodeWalk from '../../exhibits/CodeWalk'
import { highlightLines } from '../../lib/highlight'
import irData from '../../data/ir-attention.json'
import labsData from '../../data/labs.generated.json'
import { matmulTrace } from '../../exhibits/matmul'
import { flashTrace, ringTrace, causalSkipTrace } from '../../exhibits/flash'
import type { TraceDoc } from '../../exhibits/types'
import { STAGES } from '../../data/track'
import { CHECKLISTS } from '../../data/checklists'
import { walk as matmulWalk } from '../../data/walks/matmul'
import { walk as softmaxWalk } from '../../data/walks/softmax'
import { walk as flashWalk } from '../../data/walks/flash'
import { walk as causalWalk } from '../../data/walks/causal'

export function getStaticPaths() {
  return STAGES.map((stage) => ({ params: { id: stage.id }, props: { stage } }))
}

const { stage } = Astro.props
const prev = STAGES.find((s) => s.num === stage.num - 1)
const next = STAGES.find((s) => s.num === stage.num + 1)

const tracesByStage: Record<string, { designator: string; trace: TraceDoc }[]> = {
  pallas: [
    { designator: 'EX·02', trace: matmulTrace(4) },
    { designator: 'EX·07', trace: matmulTrace(4, false) },
  ],
  kernels: [
    { designator: 'EX·03', trace: flashTrace(4) },
    { designator: 'EX·08', trace: causalSkipTrace(4, 2) },
  ],
  distributed: [{ designator: 'EX·04', trace: ringTrace(4) }],
}
const traceExhibits = tracesByStage[stage.id] ?? []
const showRoofline = stage.id === 'machine'
const showXray = stage.id === 'ir'
const showSandbox = stage.id === 'pallas'
const showSemaphore = stage.id === 'distributed'
const extractedLabs = stage.labs.filter((l) => l.designator in labsData)
const checklist = CHECKLISTS[stage.id] ?? []

const walksByStage: Record<string, typeof matmulWalk[]> = {
  pallas: [matmulWalk, softmaxWalk],
  kernels: [flashWalk, causalWalk],
}
const stageWalks = await Promise.all(
  (walksByStage[stage.id] ?? []).map(async (w) => ({ walk: w, lines: await highlightLines(w.code, w.lang) })),
)

const slug = (h: string) => h.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
const chapterToc = stage.chapter.map((c) => ({ id: `c-${slug(c.h)}`, label: c.h.toLowerCase() }))
const fixedToc = [
  ...(showRoofline || showXray || showSandbox || showSemaphore || traceExhibits.length ? [{ id: 'instruments', label: 'instruments' }] : []),
  ...(stageWalks.length ? [{ id: 'walks', label: 'guided walks' }] : []),
  { id: 'built', label: 'what gets built' },
  ...(stage.readings.length ? [{ id: 'readings', label: 'readings' }] : []),
  { id: 'work', label: 'the work, in order' },
  ...(stage.labs.length ? [{ id: 'labs', label: 'labs' }] : []),
  ...(extractedLabs.length ? [{ id: 'notebook', label: 'from the notebook' }] : []),
  ...(checklist.length ? [{ id: 'canyou', label: 'can you' }] : []),
  { id: 'gate', label: 'the gate' },
]
const toc = [...chapterToc, ...fixedToc]
---

<Base title={`Stage ${stage.num}: ${stage.title} — Rudrite Kernels`} description={stage.goal}>
  <div class="wrap layout">
    <aside class="side">
      <Spine currentLayer={stage.layer} />
      <nav class="toc" aria-label="On this page">
        <span class="mono-label toc-head">on this page</span>
        <ol>
          {toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
        </ol>
      </nav>
    </aside>

    <article class="main">
      <p class="mono-label kicker">the path · chapter {String(10 + stage.num).padStart(2, '0')} of 15 · part ii, the track</p>
      <TitleBlock stage={stage} />

      <section class="block prose">
        <p class="goal">{stage.goal}</p>
      </section>

      <section class="block howto" aria-label="How to work this stage">
        <span class="mono-label">how to work this stage</span>
        <ol>
          <li>read the chapter</li>
          <li>do the readings</li>
          <li>work the weeks in order</li>
          <li>run the labs in Colab</li>
          <li>attempt the gate</li>
        </ol>
      </section>

      {
        stage.chapter.map((sec) => (
          <section class="block prose">
            <SectionHead id={`c-${slug(sec.h)}`} eyebrow="the chapter" title={sec.h} />
            {sec.ps.map((p) =>
              p.startsWith('>> ') ? (
                <blockquote class="pull">{p.slice(3)}</blockquote>
              ) : (
                <p class="theory">
                  <Rich text={p} />
                </p>
              ),
            )}
          </section>
        ))
      }

      {
        (showRoofline || showXray || showSandbox || showSemaphore || traceExhibits.length > 0) && (
          <section class="block">
            <SectionHead id="instruments" eyebrow="hands on the machine" title="Instruments" />
            <div class="ex-stack">
              {showRoofline && (
                <>
                  <Exhibit designator="EX·06" title="the memory hierarchy, to its real widths" provenance="constants from jax-ml.github.io/scaling-book (retrieved 2026-07-26) · nothing invented">
                    <MemoryHierarchy />
                  </Exhibit>
                  <Exhibit designator="EX·01" title="the roofline playground" provenance="chip constants from jax-ml.github.io/scaling-book (retrieved 2026-07-26) · all values computed, nothing invented">
                    <Roofline client:visible />
                  </Exhibit>
                </>
              )}
              {traceExhibits.map((ex) => (
                <Exhibit designator={ex.designator} title={ex.trace.title} provenance={ex.trace.provenance}>
                  <Choreographer trace={ex.trace} client:visible />
                </Exhibit>
              ))}
              {showXray && (
                <Exhibit designator="EX·05" title="the IR x-ray · one program, three layers" provenance={irData.provenance}>
                  <IRXray client:visible />
                </Exhibit>
              )}
              {showSandbox && (
                <Exhibit designator="EX·09" title="the BlockSpec sandbox" provenance="all legality arithmetic computed live: lattice rules, grid, and the v5e VMEM budget · diagnostic wording is ours, the arithmetic is the chip's">
                  <BlockSpecSandbox client:visible />
                </Exhibit>
              )}
              {showSemaphore && (
                <Exhibit designator="EX·10" title="the semaphore timeline · a deadlock, stepped into" provenance="ordering computed from an explicit dependency model of a 4-chip ring all-gather · toggle one wait and walk into the cycle">
                  <SemTimeline client:visible />
                </Exhibit>
              )}
            </div>
          </section>
        )
      }

      {
        stageWalks.length > 0 && (
          <section class="block">
            <SectionHead id="walks" eyebrow="line by line, at your pace" title="Guided walks" />
            <div class="ex-stack">
              {stageWalks.map((w) => (
                <Exhibit designator={`WALK·${w.walk.id}`} title={w.walk.title} provenance="code verbatim from the lab notebook · step with the buttons or j/k">
                  <CodeWalk lines={w.lines} steps={w.walk.steps} title={w.walk.title} client:visible />
                </Exhibit>
              ))}
            </div>
          </section>
        )
      }

      <section class="block prose">
        <SectionHead id="built" eyebrow="deliverables" title="What gets built" />
        <ul class="build">
          {stage.build.map((b) => <li>{b}</li>)}
        </ul>
      </section>

      {
        stage.readings.length > 0 && (
          <section class="block prose">
            <SectionHead id="readings" eyebrow="sources" title="Readings" />
            <ul class="readings">
              {stage.readings.map((r) => (
                <li>
                  <a href={r.url} rel="noopener">{r.label}</a>
                  <span class="rnote"> · {r.note}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="block prose">
        <SectionHead id="work" eyebrow="the plan" title="The work, in order" />
        {
          stage.work.map((w) => (
            <div class="workblock">
              <h3 class="wlabel">{w.label}</h3>
              <ul>
                {w.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))
        }
      </section>

      {
        stage.labs.length > 0 && (
          <section class="block">
            <SectionHead id="labs" eyebrow="run it yourself" title="Labs" />
            <div class="lab-grid">
              {stage.labs.map((lab) => (
                <LabCard lab={lab} />
              ))}
            </div>
          </section>
        )
      }

      {
        extractedLabs.length > 0 && (
          <section class="block">
            <SectionHead id="notebook" eyebrow="single source of truth" title="From the notebook" />
            <div class="ex-stack">
              {extractedLabs.map((l) => (
                <NotebookPeek designator={l.designator} />
              ))}
            </div>
          </section>
        )
      }

      {
        checklist.length > 0 && (
          <section class="block">
            <SectionHead id="canyou" eyebrow="the self-test, before the gate" title="Can you" />
            <div class="panel canyou-panel">
              <Checklist id={stage.id} items={checklist} client:visible />
              <div class="provenance">checked state lives in your browser only · the gate below is the public half</div>
            </div>
          </section>
        )
      }

      <section class="block">
        <SectionHead id="gate" eyebrow="pass or fail, in public" title="The gate" />
        <GateStamp stage={stage} />
        <p class="artifact prose">Public artifact for this stage: {stage.artifact.replace(/^Explainers?: /, '')}.</p>
      </section>

      <nav class="pager" aria-label="The path">
        {prev ? <a href={`/s/${prev.id}`}>← ch {String(10 + prev.num).padStart(2, '0')} · {prev.title}</a> : <a href="/l/ici">← ch 09 · ICI ⇄ chips</a>}
        {next ? <a href={`/s/${next.id}`}>ch {String(10 + next.num).padStart(2, '0')} · {next.title} →</a> : <a href="/bench">the bench →</a>}
      </nav>
    </article>

    <aside class="right">
      <div class="rail">
        <div>
          <span class="rail-head">reading progress</span>
          <span class="progress-num meas">0%</span>
          <div class="progress-bar"><i></i></div>
        </div>
        <div>
          <span class="rail-head">stage</span>
          <div class="card">
            <div class="row"><span class="k">schedule</span><span>{stage.weeks}</span></div>
            <div class="row"><span class="k">labs</span><span>{stage.labs.length}</span></div>
            <div class="row"><span class="k">gate</span><span>{stage.gate.state}</span></div>
            <div class="row"><span class="k">hardware</span><span>Colab TPU</span></div>
          </div>
        </div>
        <div>
          <span class="rail-head">part of</span>
          <ul>
            <li><a href="/">the path · fifteen chapters</a></li>
            {prev && <li><a href={`/s/${prev.id}`}>before: {prev.title}</a></li>}
            {next && <li><a href={`/s/${next.id}`}>next: {next.title}</a></li>}
          </ul>
        </div>
        <div>
          <span class="rail-head">related</span>
          <ul>
            <li><a href="/bench">the bench · every number</a></li>
            <li><a href="https://github.com/rudrite/kernels" rel="noopener">the repo · labs and curriculum</a></li>
          </ul>
        </div>
      </div>
    </aside>
  </div>
  <ReadingRails />
</Base>

<style>
  .layout { display: grid; grid-template-columns: 12.5rem minmax(0, 1fr) 13rem; gap: 3rem; padding-block: 2.5rem; }
  .side, .right { position: sticky; top: 2rem; align-self: start; }
  @media (max-width: 1240px) { .layout { grid-template-columns: 12.5rem minmax(0, 1fr); } .right { display: none; } }
  @media (max-width: 960px) { .layout { grid-template-columns: 1fr; } .side { position: static; display: none; } }

  .kicker { color: var(--copper-deep); margin-bottom: 0.875rem; }
  .block { margin-top: 3rem; }
  .goal { font-size: 1.25rem; line-height: 1.55; }
  .howto { display: flex; align-items: baseline; gap: 1.25rem; flex-wrap: wrap; border-block: 1px solid var(--rule-soft); padding-block: 0.75rem; margin-top: 1.75rem; }
  .howto ol { display: flex; gap: 1.5rem; flex-wrap: wrap; margin: 0; padding: 0; list-style: none; counter-reset: step; font-family: var(--mono); font-size: 0.75rem; color: var(--ink-mute); }
  .howto li { counter-increment: step; }
  .howto li::before { content: counter(step) ' · '; color: var(--copper-deep); }

  .theory { margin-bottom: 1em; }
  .build { padding-left: 1.1em; }
  .build li { margin-bottom: 0.45em; }
  .readings { list-style: none; padding: 0; }
  .readings li { margin-bottom: 0.6em; }
  .readings a { font-family: var(--mono); font-size: 0.875rem; }
  .rnote { color: var(--ink-mute); font-size: 0.9375rem; }
  .workblock { margin-bottom: 1.25rem; }
  .wlabel { font-family: var(--mono); font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.04em; color: var(--copper-deep); margin-bottom: 0.5rem; }
  .workblock ul { padding-left: 1.1em; }
  .workblock li { margin-bottom: 0.4em; }
  .lab-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: 1rem; }
  .ex-stack { display: flex; flex-direction: column; gap: 1.25rem; }
  .canyou-panel { padding-top: 0.5rem; }
  .artifact { margin-top: 1rem; color: var(--ink-mute); }

  .pager { display: flex; justify-content: space-between; gap: 1rem; margin-top: 3.5rem; padding-top: 1.25rem; border-top: 1px solid var(--rule); font-family: var(--mono); font-size: 0.8125rem; }
  .pager a { text-decoration: none; color: var(--ink-mute); }
  .pager a:hover { color: var(--copper-deep); }
</style>
