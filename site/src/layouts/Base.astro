---
import '@fontsource/ibm-plex-serif/400.css'
import '@fontsource/ibm-plex-serif/400-italic.css'
import '@fontsource/ibm-plex-serif/600.css'
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/500.css'
import '@fontsource/vt323/400.css'
// the display grotesque carries headlines and section heads only (ADR 0003)
import '@fontsource/inter-tight/latin-700.css'
import '@fontsource/inter-tight/latin-800.css'
import 'katex/dist/katex.min.css'
import '../styles/global.css'
import Lockup from '../components/Lockup.astro'
import PathStrip from '../components/PathStrip.astro'
import ProgressKit from '../components/ProgressKit.astro'
import SearchPalette from '../exhibits/SearchPalette'
import CodeChrome from '../components/CodeChrome.astro'
import { SEARCH_INDEX } from '../lib/search-index'

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props

// build format 'file' can surface index pages as /jax.html at render time
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/+$/, '') || '/'
const seg = path.split('/').filter(Boolean)
// A card per surface, falling back to the site card. Stages keep their own;
// the sibling paths and the workshop share one card each, and their
// sub-pages inherit it (a jax chapter shows the jax card).
const ogSlug =
  path === '/' ? 'home'
  : seg[0] === 'bench' ? 'bench'
  : seg[0] === 's' ? seg[1]!
  : ['jax', 'xla', 'pytorch', 'gym', 'mistakes'].includes(seg[0]!) ? seg[0]!
  : 'home'
const ogImage = new URL(`/og/${ogSlug}.png`, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a stored scheme choice before first paint; no flash either way.
      try {
        var t = localStorage.getItem('theme')
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="home-link" aria-label="Rudrite Kernels home">
          <span class="lk-desktop"><Lockup size={26} tagline /></span>
          <span class="lk-mobile"><Lockup size={20} /></span>
        </a>
        <nav aria-label="Site">
          <button type="button" class="mono-label search-btn" onclick="window.dispatchEvent(new Event('open-palette'))">
            chapters / search <kbd>⌘K</kbd>
          </button>
          <a href="/" class="mono-label">Map</a>
          <a href="/routes" class="mono-label">Routes</a>
          <a href="https://github.com/rudrite/kernels" rel="noopener" class="mono-label">GitHub</a>
          <button type="button" class="mode-btn" id="mode-toggle" title="Switch color scheme" aria-label="Switch color scheme">
            <svg class="mi mi-sun" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
              <circle cx="8" cy="8" r="3.1" />
              <path d="M8 1.2v1.7M8 13.1v1.7M1.2 8h1.7M13.1 8h1.7M3.2 3.2l1.2 1.2M11.6 11.6l1.2 1.2M12.8 3.2l-1.2 1.2M4.4 11.6l-1.2 1.2" />
            </svg>
            <svg class="mi mi-moon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M13.2 9.6a5.6 5.6 0 1 1-6.8-6.8 4.4 4.4 0 1 0 6.8 6.8Z" />
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <PathStrip />
    <script is:inline>
      // The scheme toggle: an explicit choice is stored and beats the system
      // setting; the label names the mode a click would switch to.
      ;(function () {
        var btn = document.getElementById('mode-toggle')
        if (!btn) return
        function effective() {
          var t = document.documentElement.dataset.theme
          if (t === 'light' || t === 'dark') return t
          return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        }
        function paint() {
          // show the icon of the mode a click switches to
          var dark = effective() === 'dark'
          btn.querySelector('.mi-sun').style.display = dark ? 'block' : 'none'
          btn.querySelector('.mi-moon').style.display = dark ? 'none' : 'block'
          btn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode')
          btn.setAttribute('title', dark ? 'Switch to light mode' : 'Switch to dark mode')
        }
        btn.addEventListener('click', function () {
          var next = effective() === 'dark' ? 'light' : 'dark'
          document.documentElement.dataset.theme = next
          try { localStorage.setItem('theme', next) } catch (e) {}
          paint()
        })
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', paint)
        paint()
      })()
    </script>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="wrap foot">
        <span class="mono-label">rudrite kernels</span>
        <span class="foot-note">powered by TPUs and curiosity</span>
      </div>
    </footer>
    <SearchPalette index={SEARCH_INDEX} client:load />
    <ProgressKit />
    <CodeChrome />
  </body>
</html>

<style>
  .site-header {
    border-bottom: 2px solid var(--edge); background: var(--plate);
    background-image: repeating-linear-gradient(to bottom, var(--scan) 0 1px, transparent 1px 3px);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; padding-block: 0.9rem; }
  .home-link { text-decoration: none; }
  .lk-mobile { display: none; }
  @media (max-width: 700px) {
    .lk-desktop { display: none; }
    .lk-mobile { display: inline; }
    .bar { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
    nav { gap: 0.25rem 1rem; }
    .search-btn { margin-right: 0.25rem; }
  }
  nav { display: flex; gap: 1.4rem; align-items: center; flex-wrap: wrap; }
  nav a { text-decoration: none; color: var(--ink-mute); padding-block: 0.35rem; }
  nav a:hover { color: var(--accent); text-shadow: var(--bloom); }
  .search-btn { background: var(--plate-2); border: 1px solid var(--edge); border-radius: 3px; padding: 0.3rem 0.6rem; color: var(--ink-mute); cursor: pointer; display: inline-flex; gap: 0.5rem; align-items: center; }
  .search-btn:hover { border-color: var(--accent); color: var(--accent); }
  .mode-btn { background: var(--plate-2); border: 1px solid var(--edge); border-radius: 3px; padding: 0.35rem; color: var(--ink-mute); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .mode-btn svg { display: block; }
  .mode-btn .mi-moon { display: none; }
  .mode-btn:hover { border-color: var(--accent); color: var(--accent); filter: drop-shadow(var(--bloom)); }
  .search-btn kbd { font-family: var(--mono); font-size: 0.625rem; border: 1px solid var(--edge); border-radius: 3px; padding: 0.05rem 0.25rem; }
  @media (max-width: 900px) { .search-btn kbd { display: none; } }
  .site-footer { border-top: 2px solid var(--edge); margin-top: 5rem; background: var(--plate); }
  .foot { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-block: 1.25rem; flex-wrap: wrap; }
  .foot-note { font-family: var(--mono); font-size: 0.75rem; color: var(--ink-mute); max-width: 52ch; text-align: right; }
  @media (max-width: 700px) { .foot-note { text-align: left; } }
</style>
