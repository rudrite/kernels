---
import '@fontsource/ibm-plex-serif/400.css'
import '@fontsource/ibm-plex-serif/400-italic.css'
import '@fontsource/ibm-plex-serif/600.css'
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/500.css'
import '@fontsource/vt323/400.css'
import 'katex/dist/katex.min.css'
import '../styles/global.css'
import Lockup from '../components/Lockup.astro'
import ProgressKit from '../components/ProgressKit.astro'
import SearchPalette from '../exhibits/SearchPalette'
import CodeChrome from '../components/CodeChrome.astro'
import { SEARCH_INDEX } from '../lib/search-index'

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props

const path = Astro.url.pathname
const ogSlug = path === '/' ? 'home' : path === '/bench' ? 'bench' : path.startsWith('/s/') ? path.split('/')[2]! : 'home'
const ogImage = new URL(`/og/${ogSlug}.png`, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="home-link" aria-label="Rudrite Kernels home">
          <span class="lk-desktop"><Lockup size={26} tagline /></span>
          <span class="lk-mobile"><Lockup size={20} /></span>
        </a>
        <nav aria-label="Site">
          <button type="button" class="mono-label search-btn" onclick="window.dispatchEvent(new Event('open-palette'))">
            chapters / search <kbd>⌘K</kbd>
          </button>
          <a href="/" class="mono-label">Path</a>
          <a href="/gym" class="mono-label">Gym</a>
          <a href="/mistakes" class="mono-label">Mistakes</a>
          <a href="/bench" class="mono-label">Bench</a>
          <a href="https://github.com/rudrite/kernels" rel="noopener" class="mono-label">GitHub</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="wrap foot">
        <span class="mono-label">rudrite kernels</span>
        <span class="foot-note">powered by TPUs and curiosity</span>
      </div>
    </footer>
    <SearchPalette index={SEARCH_INDEX} client:load />
    <ProgressKit />
    <CodeChrome />
  </body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--rule); background: var(--paper-high); }
  .bar { display: flex; align-items: center; justify-content: space-between; padding-block: 0.875rem; }
  .home-link { text-decoration: none; }
  .lk-mobile { display: none; }
  @media (max-width: 700px) {
    .lk-desktop { display: none; }
    .lk-mobile { display: inline; }
  }
  nav { display: flex; gap: 1.5rem; align-items: center; }
  nav a { text-decoration: none; color: var(--ink-mute); }
  nav a:hover { color: var(--copper-deep); }
  .search-btn { background: var(--paper); border: 1px solid var(--rule); border-radius: 2px; padding: 0.3rem 0.6rem; color: var(--ink-mute); cursor: pointer; display: inline-flex; gap: 0.5rem; align-items: center; }
  .search-btn:hover { border-color: var(--copper-deep); color: var(--copper-deep); }
  .search-btn kbd { font-family: var(--mono); font-size: 0.625rem; border: 1px solid var(--rule); border-radius: 2px; padding: 0.05rem 0.25rem; }
  @media (max-width: 900px) { .search-btn kbd { display: none; } }
  .site-footer { border-top: 1px solid var(--rule); margin-top: 5rem; }
  .foot { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-block: 1.25rem; flex-wrap: wrap; }
  .foot-note { font-family: var(--mono); font-size: 0.75rem; color: var(--ink-mute); max-width: 52ch; text-align: right; }
  @media (max-width: 700px) { .foot-note { text-align: left; } }
</style>
