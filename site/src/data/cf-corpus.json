    "def running_mean(xs):",
    "    def step(carry, x):",
    "        total, n = carry",
    "        return (total + x, n + 1.0), (total + x) / (n + 1.0)",
    "    (_, _), means = jax.lax.scan(step, (jnp.zeros(xs.shape[1]), 0.0), xs)",
    "    return means"
   ],
